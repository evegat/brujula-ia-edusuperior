---
// src/components/BancoBuenasPracticas.astro
// Muro colaborativo de ideas y casos prácticos de profesores usando IA
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="buenas-practicas" style="margin-bottom: 4rem; scroll-margin-top: 2rem;">
  
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 1.75rem;">
    <div>
      <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem;">
        <span class="badge badge-green">{t('ideas.badge_community')}</span>
        <span class="badge badge-blue">{t('ideas.badge_real')}</span>
      </div>
      <h2 style="font-family: var(--font-serif); font-size: 1.85rem; margin: 0 0 0.5rem 0; color: var(--text-main);">
        {t('ideas.title')}
      </h2>
      <p style="color: var(--text-muted); max-width: 820px; font-size: 0.96rem; line-height: 1.55; margin: 0;">
        {t('ideas.desc')}
      </p>
    </div>

    <!-- Acciones Rápidas -->
    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
      <a 
        href="mailto:eduardo@evegat.cl?subject=Propuesta%20de%20Buena%20Pr%C3%A1ctica%20IA%20-%20Br%C3%BAjula%20IA&body=Hola%20Eduardo%2C%0A%0AQuiero%20compartir%20esta%20experiencia%20o%20ejercicio%20de%20aula%20para%20el%20Banco%20de%20Buenas%20Pr%C3%A1cticas%3A%0A%0A-%20Nombre%20del%20profesor%2Fa%3A%20%0A-%20Cargo%20y%20Carrera%2FUniversidad%3A%20%0A-%20Nombre%20de%20la%20actividad%20o%20idea%3A%20%0A-%20%C2%BFEn%20qu%C3%A9%20consiste%3F%20(Breve%20explicaci%C3%B3n)%3A%20%0A-%20Resultados%20o%20aprendizajes%3A%20%0A-%20Enlace%20a%20perfil%20(LinkedIn%20o%20web)%20para%20el%20cr%C3%A9dito%3A%20%0A%0ASaludos%2C"
        class="btn btn-primary btn-sm"
        style="display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;"
      >
        {t('ideas.btn_submit')}
      </a>
      <a 
        href="https://github.com/evegat/brujula-ia-edusuperior"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-sm"
        style="display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;"
      >
        <svg style="width: 14px; height: 14px; fill: currentColor;" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
        {t('ideas.btn_github')}
      </a>
    </div>
  </div>

  <!-- TARJETAS DE CASOS REALES DE PROFESORES -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    
    <!-- Caso 1: Alucinaciones como Antídoto -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-top: 4px solid var(--accent-amber); border-radius: 10px; padding: 1.35rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span class="badge badge-amber">Pensamiento Crítico</span>
          <span style="font-size: 0.74rem; color: var(--text-muted);">1° Año Universitario</span>
        </div>
        <h3 style="font-size: 1.15rem; margin: 0 0 0.5rem 0; font-family: var(--font-serif); color: var(--text-main);">
          Usar las alucinaciones de la IA como antídoto crítico
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.85rem 0;">
          En lugar de pedir a los alumnos que no usen IA, se les pide deliberadamente que le ordenen a un modelo generar un ensayo histórico o técnico sobre un tema específico. El ejercicio de clase consiste en rastrear y documentar las fuentes que la IA inventó o citó mal, contrastándolas en biblioteca con libros reales.
        </p>
      </div>
      <div style="background: var(--canvas-bg); border: 1px solid var(--border-color); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.78rem; color: var(--text-main);">
        <strong>Aprendizaje clave:</strong> Los estudiantes descubren de forma práctica que los modelos son probabilísticos y no buscadores infalibles, desarrollando el hábito reflejo de verificar antes de creer.
        <div style="margin-top: 0.35rem; color: var(--accent-blue); font-weight: 600;">
          👤 Cátedra: Tecnologías de Información (Eduardo Vega T.)
        </div>
      </div>
    </div>

    <!-- Caso 2: Auditoría Inversa de Excel -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-top: 4px solid var(--accent-green); border-radius: 10px; padding: 1.35rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span class="badge badge-green">Auditoría & Finanzas</span>
          <span style="font-size: 0.74rem; color: var(--text-muted);">Gestión Pública</span>
        </div>
        <h3 style="font-size: 1.15rem; margin: 0 0 0.5rem 0; font-family: var(--font-serif); color: var(--text-main);">
          Auditoría inversa de planillas de cálculo con IA
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.85rem 0;">
          Los estudiantes aprenden a solicitar a la IA que deconstruya fórmulas complejas de Excel (matrices dinámicas, `BUSCARX`, condicionales anidados) para entender su lógica interna. Luego usan ese mismo método para auditar planillas de presupuestos públicos reales y encontrar incongruencias aritméticas o de diseño.
        </p>
      </div>
      <div style="background: var(--canvas-bg); border: 1px solid var(--border-color); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.78rem; color: var(--text-main);">
        <strong>Aprendizaje clave:</strong> La IA se utiliza como un tutor técnico que explica líneas de código y fórmulas opacas, empoderando a estudiantes de ciencias sociales sin formación previa en programación.
        <div style="margin-top: 0.35rem; color: var(--accent-blue); font-weight: 600;">
          👤 Cátedra: Gobernar con Datos (Eduardo Vega T.)
        </div>
      </div>
    </div>

    <!-- Caso 3: Asistente Cristina para Entregas -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-top: 4px solid var(--accent-blue); border-radius: 10px; padding: 1.35rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span class="badge badge-blue">Tutoría Formativa</span>
          <span style="font-size: 0.74rem; color: var(--text-muted);">Rúbricas Ex-Ante</span>
        </div>
        <h3 style="font-size: 1.15rem; margin: 0 0 0.5rem 0; font-family: var(--font-serif); color: var(--text-main);">
          Asistente virtual de retroalimentación ex-ante (Caso Cristina)
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.85rem 0;">
          Creación de un asistente configurado con la rúbrica oficial de la cátedra y el rol de una contraparte técnica exigente (estándar Dipres). Los estudiantes someten sus borradores al asistente antes de la entrega final; el bot no les hace el trabajo, sino que les formula preguntas duras y objeciones sobre sus supuestos no probados.
        </p>
      </div>
      <div style="background: var(--canvas-bg); border: 1px solid var(--border-color); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.78rem; color: var(--text-main);">
        <strong>Aprendizaje clave:</strong> Transforma la entrega de un trabajo en un proceso interactivo de mejora continua, reduciendo la ansiedad y elevando drásticamente el estándar argumental.
        <div style="margin-top: 0.35rem; color: var(--accent-blue); font-weight: 600;">
          👤 Cátedra: Gobernar con Datos (Eduardo Vega T.)
        </div>
      </div>
    </div>

    <!-- Caso 4: Scripts de Procesamiento Cuanti/Cuali -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-top: 4px solid #8b5cf6; border-radius: 10px; padding: 1.35rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span class="badge" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.25);">Análisis de Información</span>
          <span style="font-size: 0.74rem; color: var(--text-muted);">Habilidades Digitales</span>
        </div>
        <h3 style="font-size: 1.15rem; margin: 0 0 0.5rem 0; font-family: var(--font-serif); color: var(--text-main);">
          Creación guiada de scripts de procesamiento cuanti y cuali
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 0.85rem 0;">
          Enseñar a estudiantes a estructurar instrucciones para que la IA genere pequeños scripts en Python o R que limpien bases de datos públicas, unifiquen textos desordenados o clasifiquen respuestas abiertas de entrevistas distinguiendo entre reglas semánticas deterministas y patrones probabilísticos.
        </p>
      </div>
      <div style="background: var(--canvas-bg); border: 1px solid var(--border-color); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.78rem; color: var(--text-main);">
        <strong>Aprendizaje clave:</strong> Demuestra que la programación asistida por IA es una competencia transversal de pensamiento lógico que cualquier profesional público debe dominar.
        <div style="margin-top: 0.35rem; color: var(--accent-blue); font-weight: 600;">
          👤 Cátedra: Tecnologías de Información y Datos (Eduardo Vega T.)
        </div>
      </div>
    </div>

  </div>

  <!-- BANNER DE CONVOCATORIA ABIERTA PARA ENVIAR PRÁCTICAS -->
  <div style="background: linear-gradient(135deg, rgba(14, 116, 144, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
    <div style="max-width: 680px;">
      <h3 style="font-size: 1.2rem; margin: 0 0 0.35rem 0; font-family: var(--font-serif); color: var(--text-main);">
        ¿Tienes una experiencia, rúbrica o ejercicio para compartir?
      </h3>
      <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
        Este banco es un bien público colaborativo. Si eres docente, ayudante o directivo y has probado una forma útil de integrar o evaluar con IA en tus clases, envíanos los detalles. La revisaremos y la publicaremos con tu crédito formal, carrera y universidad.
      </p>
    </div>
    
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a 
        href="mailto:eduardo@evegat.cl?subject=Propuesta%20de%20Buena%20Pr%C3%A1ctica%20IA&body=Hola%20Eduardo%2C%20adjunto%20mi%20experiencia%20docente%3A"
        class="btn btn-primary btn-sm"
        style="text-decoration: none;"
      >
        ✉️ Enviar a eduardo@evegat.cl
      </a>
      <a 
        href="https://github.com/evegat/brujula-ia-edusuperior/tree/master/buenas-practicas"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-sm"
        style="text-decoration: none;"
      >
        📂 Ver Carpeta en GitHub
      </a>
    </div>
  </div>

</section>
