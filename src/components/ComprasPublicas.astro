---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import comprasData from '../../data/compras_clasificadas.json';
import TableroCorrelacionEstatales from './TableroCorrelacionEstatales.astro';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const totalCompras = comprasData.length; // 85
const totalLicitaciones = comprasData.filter(c => c.tipo_instrumento === 'Licitación Pública').length; // 15
const totalOCs = comprasData.filter(c => c.tipo_instrumento === 'Orden de Compra').length; // 66
const uesUnicas = Array.from(new Set(comprasData.map(c => c.universidad))).sort();
const montoNetoTotal = comprasData
  .filter(c => c.computa_monto_neto !== false)
  .reduce((acc, c) => acc + (c.monto || 0), 0); // ~$489.4M

function normalizeForSearch(str: string): string {
  return (str || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}

function formatearMonto(monto: number): string {
  if (!monto || isNaN(monto)) return '—';
  return '$' + Math.round(monto).toLocaleString('es-CL');
}

function obtenerBadgeCapa(capa: string, langKey: SupportedLang): { label: string; cls: string } {
  switch (capa) {
    case 'Infraestructura_Computo':
      return { 
        label: langKey === 'en' ? 'Computing' : langKey === 'pt' ? 'Computação' : 'Cómputo', 
        cls: 'badge-blue' 
      };
    case 'Gestion_Backoffice':
      return { 
        label: langKey === 'en' ? 'Back-office' : langKey === 'pt' ? 'Back-office' : 'Back-office', 
        cls: 'badge-purple' 
      };
    case 'Atencion_Frontoffice':
      return { 
        label: langKey === 'en' ? 'Chatbots' : langKey === 'pt' ? 'Chatbots' : 'Chatbots', 
        cls: 'badge-amber' 
      };
    case 'Docencia_Aula':
      return { 
        label: langKey === 'en' ? 'Instruction' : langKey === 'pt' ? 'Docência' : 'Docencia', 
        cls: 'badge-green' 
      };
    default:
      return { label: capa, cls: 'badge-blue' };
  }
}
---

<section id="compras" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.4rem;">
        <span class="badge badge-amber">{t('compras.badge_state_only')}</span>
        <span class="badge badge-blue">{t('compras.badge_chilecompra')}</span>
      </div>
      <h2>{t('compras.title')}</h2>
      <p style="color:var(--text-muted); max-width:850px; font-size:0.96rem; line-height:1.55; margin-bottom:1rem;">
        {t('compras.desc')}
      </p>
      
      <!-- Nota Metodológica de Alcance -->
      <div style="background:rgba(0,0,0,0.03); border-left:3px solid var(--accent-amber); padding:0.75rem 1rem; border-radius:0 6px 6px 0; font-size:0.84rem; color:var(--text-main); line-height:1.45;">
        <strong>{lang === 'en' ? 'Study Scope:' : lang === 'pt' ? 'Escopo do Estudo:' : 'Alcance del estudio:'}</strong> {t('compras.scope_note')}
      </div>
    </div>

    <!-- Botón de Descarga Directa CSV de Compras -->
    <div style="display:flex; gap:0.5rem; align-items:center;">
      <a 
        href="/compras_ia_estatales.csv" 
        data-download-gate="true"
        data-file-label="Compras Públicas de IA en Ues Estatales (.csv)"
        class="btn btn-outline btn-sm" 
        style="font-size:0.82rem; color:var(--accent-amber); border-color:var(--accent-amber); text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem;"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        {lang === 'en' ? 'Download Procurement (.csv)' : lang === 'pt' ? 'Baixar Licitações (.csv)' : 'Descargar Compras (.csv)'}
      </a>
    </div>
  </div>

  <!-- Estadísticas Principales de Compras -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap:1.25rem; margin-bottom:2rem;">
    <div class="card" style="border-left:4px solid var(--accent-blue); padding:1.25rem;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-blue); font-family:var(--font-serif);">{totalCompras} <span style="font-size:0.9rem; font-weight:600; color:var(--text-muted);">(63 {lang === 'en' ? 'processes' : lang === 'pt' ? 'processos' : 'procesos'})</span></div>
      <div style="font-size:0.8rem; color:var(--text-muted); line-height:1.35; margin-top:0.2rem;">
        {lang === 'en' ? '81 records: 15 public tenders & 66 purchase orders' : lang === 'pt' ? '81 registros: 15 licitações públicas e 66 ordens de compra' : '81 registros: 15 licitaciones públicas y 66 órdenes de compra'}
      </div>
    </div>
    <div class="card" style="border-left:4px solid var(--accent-green); padding:1.25rem;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif);">{uesUnicas.length} {lang === 'en' ? 'HEIs' : lang === 'pt' ? 'Instituições' : 'Planteles'}</div>
      <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.2rem;">{t('compras.kpi_state_buyers')}</div>
    </div>
    <div class="card" style="border-left:4px solid var(--accent-red); padding:1.25rem;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-red); font-family:var(--font-serif);">30%</div>
      <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.2rem;">{t('compras.kpi_without_policy')}</div>
    </div>
    <div class="card" style="border-left:4px solid var(--accent-purple); padding:1.25rem;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-purple); font-family:var(--font-serif);">$489.4M <span style="font-size:0.82rem; font-weight:600; color:var(--text-muted);">CLP</span></div>
      <div style="font-size:0.8rem; color:var(--text-muted); line-height:1.35; margin-top:0.2rem;">
        {lang === 'en' ? 'Net audited spend (deduplicating $70.6M from tenders with issued POs)' : lang === 'pt' ? 'Gasto líquido auditado (deduplicando $70.6M de licitações com OCs emitidas)' : 'Gasto neto auditado (deduplica $70.6M de licitaciones con OCs emitidas)'}
      </div>
    </div>
  </div>

  <!-- Tablero 2x2 de Correlación Ejecutiva -->
  <TableroCorrelacionEstatales lang={lang} />

  <!-- Barra de Filtros y Búsqueda de Compras -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; padding:1.25rem; margin-bottom:1.5rem; box-shadow:var(--shadow-sm);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem;">
      
      <!-- Filtros por Capa Funcional -->
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="compras-capa-buttons">
        <button type="button" class="btn btn-primary btn-sm btn-capa" data-capa="todas">
          {lang === 'en' ? 'All' : lang === 'pt' ? 'Todas' : 'Todas'} ({totalCompras})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-capa" data-capa="Infraestructura_Computo">
          {lang === 'en' ? 'Computing (14)' : lang === 'pt' ? 'Computação (14)' : 'Cómputo (14)'}
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-capa" data-capa="Gestion_Backoffice">
          Back-office (27)
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-capa" data-capa="Atencion_Frontoffice">
          Chatbots (33)
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-capa" data-capa="Docencia_Aula">
          {lang === 'en' ? 'Instruction (11)' : lang === 'pt' ? 'Docência (11)' : 'Docencia (11)'}
        </button>
      </div>

      <!-- Filtro por Universidad y Búsqueda -->
      <div style="display:flex; gap:0.6rem; flex-wrap:wrap; min-width:280px; flex:1; max-width:480px;">
        <select id="compras-select-u" style="padding:0.45rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--canvas-bg); color:var(--text-main); font-size:0.84rem; max-width:200px;">
          <option value="todas">-- {lang === 'en' ? 'All Universities' : lang === 'pt' ? 'Todas as Universidades' : 'Todas las Universidades'} --</option>
          {uesUnicas.map(u => (
            <option value={u}>{u}</option>
          ))}
        </select>
        <input 
          type="text" 
          id="compras-search-input" 
          placeholder={lang === 'en' ? 'Search supplier, software...' : lang === 'pt' ? 'Buscar fornecedor, software...' : 'Buscar proveedor, software...'} 
          style="padding:0.45rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--canvas-bg); color:var(--text-main); font-size:0.84rem; flex:1; min-width:140px;"
        />
      </div>

    </div>

    <!-- Contador de Resultados -->
    <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.82rem; color:var(--text-muted); border-top:1px solid var(--border-color); padding-top:0.75rem;">
      <span id="compras-count-display">
        {lang === 'en' 
          ? `Showing ${totalCompras} of ${totalCompras} procurement records (${totalLicitaciones} tenders, ${totalOCs} purchase orders)`
          : lang === 'pt'
          ? `Exibindo ${totalCompras} de ${totalCompras} registros de compras (${totalLicitaciones} licitações, ${totalOCs} ordens de compra)`
          : `Mostrando ${totalCompras} de ${totalCompras} registros (${totalLicitaciones} licitaciones públicas y ${totalOCs} órdenes de compra auditadas)`}
      </span>
      <span>{lang === 'en' ? 'Official source: ChileCompra / Mercado Público' : lang === 'pt' ? 'Fonte oficial: ChileCompra / Mercado Público' : 'Fuente oficial: ChileCompra / Mercado Público'}</span>
    </div>
  </div>

  <!-- Tabla Interactiva de Compras (Prerenderizada por SSR) -->
  <div id="compras-table-container" style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; overflow-x:auto; box-shadow:var(--shadow-sm); max-width:100%; -webkit-overflow-scrolling:touch;">
    <table style="width:100%; border-collapse:collapse; font-size:0.86rem; text-align:left; min-width:700px;" id="tabla-compras">
      <thead>
        <tr style="background:var(--card-alt); border-bottom:2px solid var(--border-color); color:var(--text-muted); font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;">
          <th scope="col" style="padding:0.85rem 1rem;">{lang === 'en' ? 'University' : lang === 'pt' ? 'Universidade' : 'Universidad'}</th>
          <th scope="col" style="padding:0.85rem 1rem;">{lang === 'en' ? 'Procurement Item' : lang === 'pt' ? 'Objeto da Compra' : 'Objeto de Compra'}</th>
          <th scope="col" style="padding:0.85rem 1rem;">{lang === 'en' ? 'Functional Layer' : lang === 'pt' ? 'Camada Funcional' : 'Capa Funcional'}</th>
          <th scope="col" style="padding:0.85rem 1rem;">{lang === 'en' ? 'Supplier' : lang === 'pt' ? 'Fornecedor' : 'Proveedor'}</th>
          <th scope="col" style="padding:0.85rem 1rem; text-align:right;">{lang === 'en' ? 'Amount (CLP)' : lang === 'pt' ? 'Valor (CLP)' : 'Monto (CLP)'}</th>
          <th scope="col" style="padding:0.85rem 1rem; text-align:center;">{lang === 'en' ? 'Public Record' : lang === 'pt' ? 'Ficha Pública' : 'Ficha Mercado Público'}</th>
        </tr>
      </thead>
      <tbody id="compras-tbody">
        {comprasData.map((c, idx) => {
          const sinPoliticaPublica = ['UNIVERSIDAD TECNOLOGICA METROPOLITANA', 'UNIVERSIDAD DE LA SERENA', 'UNIVERSIDAD DEL BIO BIO'].includes(c.universidad);
          const badge = obtenerBadgeCapa(c.capa_funcional, lang);
          const esLicitacion = c.tipo_instrumento === 'Licitación Pública';
          const searchBlob = `${normalizeForSearch(c.nombre)} ${normalizeForSearch(c.descripcion)} ${normalizeForSearch(c.proveedor)} ${normalizeForSearch(c.universidad)} ${normalizeForSearch(c.codigo_mercado_publico || '')} ${normalizeForSearch(c.tipo_instrumento || '')}`;

          return (
            <tr 
              class="compra-row"
              data-capa={c.capa_funcional}
              data-universidad={c.universidad}
              data-search={searchBlob}
              style={`border-bottom: 1px solid var(--border-color); background: ${idx % 2 === 0 ? 'transparent' : 'rgba(0,0,0,0.015)'};`}
            >
              <td style="padding:0.85rem 1rem; vertical-align:top;">
                <div style="font-weight:600; color:var(--text-main);">{c.universidad}</div>
                {sinPoliticaPublica ? (
                  <span class="badge" style="font-size:0.7rem; margin-top:0.25rem; background:rgba(239, 68, 68, 0.08); color:var(--accent-red); border:1px solid rgba(239, 68, 68, 0.2);">
                    {lang === 'en' ? '○ No policy located' : lang === 'pt' ? '○ Sem política localizada' : '○ Sin política identificada'}
                  </span>
                ) : (
                  <span class="badge badge-green" style="font-size:0.7rem; margin-top:0.25rem;">
                    {lang === 'en' ? '✓ Policy identified' : lang === 'pt' ? '✓ Política identificada' : '✓ Con política identificada'}
                  </span>
                )}
              </td>
              <td style="padding:0.85rem 1rem; vertical-align:top; max-width:330px;">
                <!-- Instrumento y Código Mercado Público -->
                <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap; margin-bottom:0.35rem;">
                  {esLicitacion ? (
                    <span class="badge badge-blue" style="font-size:0.68rem; font-weight:700;">{lang === 'en' ? 'Public Tender' : lang === 'pt' ? 'Licitação Pública' : 'Licitación Pública'}</span>
                  ) : (
                    <span class="badge badge-purple" style="font-size:0.68rem; font-weight:700;">{lang === 'en' ? 'Purchase Order' : lang === 'pt' ? 'Ordem de Compra' : 'Orden de Compra'}</span>
                  )}
                  {c.codigo_mercado_publico && (
                    <code style="font-size:0.68rem; background:rgba(0,0,0,0.05); padding:0.12rem 0.35rem; border-radius:4px; font-family:var(--font-mono); color:var(--text-main);">
                      {c.codigo_mercado_publico}
                    </code>
                  )}
                </div>

                <div style="font-weight:600; margin-bottom:0.2rem; line-height:1.35;">{c.nombre}</div>
                <div style="font-size:0.78rem; color:var(--text-muted); line-height:1.4;">{c.descripcion || ''}</div>
                
                <!-- Metadatos de derivación / deduplicación -->
                {c.es_derivada && (
                  <div style="margin-top:0.3rem;">
                    <span class="badge badge-amber" style="font-size:0.66rem;">
                      ↳ {lang === 'en' ? `Derived from tender ${c.licitacion_origen}` : lang === 'pt' ? `Derivada da licitação ${c.licitacion_origen}` : `Derivada de licitación ${c.licitacion_origen}`}
                    </span>
                  </div>
                )}
                {c.tiene_ocs_asociadas && (
                  <div style="margin-top:0.3rem;">
                    <span class="badge badge-blue" style="font-size:0.66rem;">
                      ℹ️ {lang === 'en' ? 'Includes executed POs' : lang === 'pt' ? 'Possui OCs executadas associadas' : 'Incluye OCs de ejecución emitidas'}
                    </span>
                  </div>
                )}

                <div style="display:flex; gap:0.35rem; align-items:center; margin-top:0.35rem; flex-wrap:wrap;">
                  <span class="badge" style="font-size:0.68rem; background:rgba(0,0,0,0.05); color:var(--text-main); border:1px solid var(--border-color);">{c.categoria_corta || 'Tecnología'}</span>
                  <span style="font-size:0.7rem; color:var(--text-muted);">
                    {lang === 'en' ? `Confidence: ${c.confianza_clasificacion || 'High'}` : lang === 'pt' ? `Confiança: ${c.confianza_clasificacion || 'Alta'}` : `Confianza: ${c.confianza_clasificacion || 'Alta'}`}
                  </span>
                </div>
                <div style="font-size:0.74rem; color:var(--text-muted); margin-top:0.25rem;">
                  {lang === 'en' ? `Date: ${c.fecha || 'N/A'}` : lang === 'pt' ? `Data: ${c.fecha || 'N/D'}` : `Fecha: ${c.fecha || 'N/D'}`}
                </div>
              </td>
              <td style="padding:0.85rem 1rem; vertical-align:top;">
                <span class={`badge ${badge.cls}`}>{badge.label}</span>
                <div style="font-size:0.74rem; color:var(--text-muted); margin-top:0.25rem;">{c.tipo_uso || ''}</div>
              </td>
              <td style="padding:0.85rem 1rem; vertical-align:top; font-size:0.82rem; color:var(--text-main);">
                {c.proveedor || (lang === 'en' ? 'No supplier specified' : lang === 'pt' ? 'Sem fornecedor especificado' : 'Sin proveedor especificado')}
              </td>
              <td style="padding:0.85rem 1rem; vertical-align:top; text-align:right; font-weight:600; font-family:var(--font-sans);">
                {c.computa_monto_neto === false ? (
                  <div>
                    <div style="color:var(--text-muted); text-decoration:line-through; font-size:0.82rem;">{formatearMonto(c.monto)}</div>
                    <div style="font-size:0.68rem; color:var(--accent-amber); font-weight:600; line-height:1.2; margin-top:0.2rem;">
                      {lang === 'en' ? 'Deduplicated (issued POs sum)' : lang === 'pt' ? 'Deduplicado (soma em OCs)' : 'No duplica en neto (suma en OCs)'}
                    </div>
                  </div>
                ) : (
                  <div>
                    <div>{formatearMonto(c.monto)}</div>
                    {c.es_derivada && (
                      <div style="font-size:0.68rem; color:var(--accent-green); font-weight:600; margin-top:0.15rem;">
                        {lang === 'en' ? 'Net executed spend' : lang === 'pt' ? 'Gasto líquido executado' : 'Monto neto ejecutado'}
                      </div>
                    )}
                  </div>
                )}
              </td>
              <td style="padding:0.85rem 1rem; vertical-align:top; text-align:center;">
                {c.link ? (
                  <a href={c.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="font-size:0.74rem; padding:0.3rem 0.55rem; color:var(--accent-blue); display:inline-flex; align-items:center; gap:0.25rem; white-space:nowrap;">
                    {esLicitacion 
                      ? (lang === 'en' ? 'View Tender →' : lang === 'pt' ? 'Ver Licitação →' : 'Ver Licitación →')
                      : (lang === 'en' ? 'View PO →' : lang === 'pt' ? 'Ver OC →' : 'Ver Orden de Compra →')}
                  </a>
                ) : (
                  <span style="color:var(--text-muted); font-size:0.75rem;">
                    {lang === 'en' ? 'No direct link' : lang === 'pt' ? 'Sem link direto' : 'Sin enlace directo'}
                  </span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Estado Vacío -->
  <div id="compras-empty-state" style="display:none; text-align:center; padding:3rem 1.5rem; background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; margin-top:1rem;">
    <div style="margin-bottom:0.75rem; color:var(--text-muted); display:flex; justify-content:center;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>
    <div style="font-weight:600; margin-bottom:0.25rem;">
      {lang === 'en' ? 'No contracts found for these filters' : lang === 'pt' ? 'Nenhuma licitação encontrada com esses filtros' : 'No se encontraron contratos con esos filtros'}
    </div>
    <div style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">
      {lang === 'en' ? 'Try selecting another layer or clear the search query.' : lang === 'pt' ? 'Tente selecionar outra camada ou limpar a busca.' : 'Intenta seleccionar otra capa funcional o limpiar el término de búsqueda.'}
    </div>
    <button type="button" id="compras-reset-btn" class="btn btn-primary btn-sm">
      {lang === 'en' ? 'Reset Procurement Filters' : lang === 'pt' ? 'Redefinir Filtros de Compras' : 'Restablecer Filtros de Compras'}
    </button>
  </div>

</section>

<script is:inline>
  let capaFiltro = 'todas';
  let uFiltro = 'todas';
  let textoFiltro = '';

  const tbody = document.getElementById('compras-tbody');
  const rows = Array.from(document.querySelectorAll('.compra-row'));
  const countDisp = document.getElementById('compras-count-display');
  const selectU = document.getElementById('compras-select-u');
  const searchInput = document.getElementById('compras-search-input');
  const emptyState = document.getElementById('compras-empty-state');
  const resetBtn = document.getElementById('compras-reset-btn');

  function normalizeInput(str) {
    return (str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function filtrarCompras() {
    if (!tbody || rows.length === 0) return;

    const normQuery = normalizeInput(textoFiltro);
    let visibles = 0;

    rows.forEach(row => {
      const capa = row.getAttribute('data-capa');
      const u = row.getAttribute('data-universidad');
      const searchBlob = row.getAttribute('data-search') || '';

      let matchCapa = (capaFiltro === 'todas' || capa === capaFiltro);
      let matchU = (uFiltro === 'todas' || u === uFiltro);
      let matchTexto = true;

      if (normQuery) {
        matchTexto = searchBlob.includes(normQuery);
      }

      if (matchCapa && matchU && matchTexto) {
        row.style.display = '';
        visibles++;
      } else {
        row.style.display = 'none';
      }
    });

    if (countDisp) {
      const pageLang = document.documentElement.lang || 'es';
      if (pageLang === 'en') {
        countDisp.textContent = `Showing ${visibles} of ${rows.length} procurement records (15 tenders, 66 purchase orders)`;
      } else if (pageLang === 'pt') {
        countDisp.textContent = `Exibindo ${visibles} de ${rows.length} registros de compras (15 licitações, 66 ordens de compra)`;
      } else {
        countDisp.textContent = `Mostrando ${visibles} de ${rows.length} registros (15 licitaciones públicas y 66 órdenes de compra auditadas)`;
      }
    }

    const tableContainer = document.getElementById('compras-table-container');

    if (visibles === 0) {
      if (tableContainer) tableContainer.style.display = 'none';
      if (emptyState) emptyState.style.display = 'block';
    } else {
      if (tableContainer) tableContainer.style.display = 'block';
      if (emptyState) emptyState.style.display = 'none';
    }
  }

  // Listeners de Capa
  document.querySelectorAll('.btn-capa').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-capa').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      capaFiltro = btn.getAttribute('data-capa') || 'todas';
      filtrarCompras();
    });
  });

  selectU?.addEventListener('change', (e) => {
    uFiltro = e.target.value;
    filtrarCompras();
  });

  searchInput?.addEventListener('input', (e) => {
    textoFiltro = e.target.value;
    filtrarCompras();
  });

  resetBtn?.addEventListener('click', () => {
    capaFiltro = 'todas';
    uFiltro = 'todas';
    textoFiltro = '';
    if (selectU) selectU.value = 'todas';
    if (searchInput) searchInput.value = '';
    document.querySelectorAll('.btn-capa').forEach(b => {
      if (b.getAttribute('data-capa') === 'todas') {
        b.classList.remove('btn-outline');
        b.classList.add('btn-primary');
      } else {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      }
    });
    filtrarCompras();
  });
</script>
