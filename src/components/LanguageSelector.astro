---
// src/components/LanguageSelector.astro
// Selector de idiomas sobrio y accesible (ES | EN | PT)

interface Props {
  currentLang?: 'es' | 'en' | 'pt';
}

const { currentLang = 'es' } = Astro.props;

const locales = [
  { code: 'es', label: 'ES', title: 'Español (Chile)', path: '/' },
  { code: 'en', label: 'EN', title: 'English', path: '/en/' },
  { code: 'pt', label: 'PT', title: 'Português', path: '/pt/' }
];
---

<nav class="lang-selector" aria-label={currentLang === 'en' ? 'Select language' : currentLang === 'pt' ? 'Selecionar idioma' : 'Seleccionar idioma'}>
  {locales.map((loc, idx) => (
    <>
      <a 
        href={loc.path} 
        class:list={['lang-btn', { active: currentLang === loc.code }]}
        title={loc.title}
        aria-current={currentLang === loc.code ? 'page' : undefined}
      >
        {loc.label}
      </a>
      {idx < locales.length - 1 && <span class="lang-divider" aria-hidden="true">/</span>}
    </>
  ))}
</nav>

<style>
  .lang-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--card-alt, #f1f5f9);
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    border: 1px solid var(--border-color, #e2e8f0);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1;
  }

  .lang-btn {
    color: var(--text-muted, #64748b);
    text-decoration: none;
    padding: 0.25rem 0.4rem;
    border-radius: 4px;
    transition: all 0.15s ease;
    display: inline-block;
  }

  .lang-btn:hover {
    color: var(--text-main, #0f172a);
    text-decoration: none;
  }

  .lang-btn.active {
    color: var(--accent-contrast, #ffffff);
    background: var(--accent-blue, #0369a1);
    font-weight: 700;
  }

  .lang-divider {
    color: var(--border-color, #cbd5e1);
    user-select: none;
    font-size: 0.72rem;
  }
</style>
