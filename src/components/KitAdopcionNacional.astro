---
// src/components/KitAdopcionNacional.astro
// Kit de Adopción Normativa para Docentes y Rectorías — Sin AI-Slop ni letra de terminal
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import matrizData from '../../data/matriz_54_universidades.json';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const totalUes = matrizData.length; // 54
const conPrivacidad = matrizData.filter(u => u.dimensiones.privacidad_ley_21719).length; // 13
const conDocSinPriv = matrizData.filter(u => !u.en_brecha && !u.dimensiones.privacidad_ley_21719).length; // 19
const sinDoc = matrizData.filter(u => u.en_brecha).length; // 22

const pctPrivacidad = ((conPrivacidad / totalUes) * 100).toFixed(1); // 24.1%
const pctSinPriv = ((conDocSinPriv / totalUes) * 100).toFixed(1); // 35.2%
const pctSinDoc = ((sinDoc / totalUes) * 100).toFixed(1); // 40.7%
---

<section id="kit-adopcion" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.4rem;">
        <span class="badge badge-amber">{t('kit.badge_teachers')}</span>
        <span class="badge badge-blue">{t('kit.badge_countdown')}</span>
      </div>
      <h2 style="font-family: var(--font-serif); font-size: 1.85rem; margin: 0 0 0.5rem 0; color: var(--text-main);">
        {t('kit.title')}
      </h2>
      <p style="color:var(--text-muted); max-width:860px; font-size:0.96rem; line-height:1.55; margin: 0;">
        {t('kit.desc')}
      </p>
    </div>

    <!-- Enlaces de Descarga Rápida con Iconos SVG -->
    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap: wrap;">
      <a href="/kit_clausulas_docentes.md" download="kit_clausulas_ia_docentes.md" class="btn btn-primary btn-sm" style="font-size:0.82rem;">
        <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        {t('kit.btn_download_clauses')}
      </a>
      <a href="/modelo_marco_orientaciones_ia_universidades.md" download="modelo_marco_ia_universidades_chile.md" class="btn btn-outline btn-sm" style="font-size:0.82rem;">
        <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
        </svg>
        {t('kit.btn_download_model')}
      </a>
    </div>
  </div>

  <!-- RADAR LEY N° 21.719: VIGENCIA OBLIGATORIA 1 DE DICIEMBRE DE 2026 -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:8px; padding:1.5rem; margin-bottom:2.25rem; box-shadow:var(--shadow-sm); border-top:3px solid var(--accent-amber);">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.25rem;">
      <div>
        <div style="font-size:0.74rem; font-weight:700; text-transform:uppercase; color:var(--accent-amber); margin-bottom:0.35rem; letter-spacing:0.05em; display:flex; align-items:center; gap:0.4rem;">
          <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          {t('kit.radar_badge')}
        </div>
        <h3 style="font-size:1.25rem; margin-bottom:0.35rem;">
          {t('kit.radar_title')}
        </h3>
        <p style="font-size:0.88rem; color:var(--text-muted); max-width:760px; line-height:1.5; margin:0;">
          {t('kit.radar_desc')}
        </p>
      </div>

      <!-- Contador / Hito Temporal -->
      <div style="background:var(--card-alt); border:1px solid var(--border-color); padding:0.85rem 1.25rem; border-radius:6px; text-align:center;">
        <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; color:var(--accent-amber); letter-spacing:0.05em;">
          {t('kit.radar_vigencia_title')}
        </div>
        <div style="font-size:1.45rem; font-weight:700; font-family:var(--font-serif); color:var(--text-main); font-variant-numeric: tabular-nums;">
          {t('kit.radar_vigencia_date')}
        </div>
        <div style="font-size:0.74rem; color:var(--text-muted);">
          {t('kit.radar_vigencia_sub')}
        </div>
      </div>
    </div>

    <!-- Termómetro de Preparación Universitaria -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap:1rem; margin-bottom:1.25rem;">
      
      <div style="background:var(--card-alt); border:1px solid var(--border-color); border-left:3px solid var(--accent-green); padding:1rem; border-radius:6px;">
        <div style="font-size:1.5rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif); font-variant-numeric: tabular-nums;">
          {conPrivacidad} {lang === 'en' ? 'of' : 'de'} {totalUes} <span style="font-size:0.82rem; font-weight:600;">({pctPrivacidad}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card1_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card1_desc')}
        </div>
      </div>

      <div style="background:var(--card-alt); border:1px solid var(--border-color); border-left:3px solid var(--accent-amber); padding:1rem; border-radius:6px;">
        <div style="font-size:1.5rem; font-weight:700; color:var(--accent-amber); font-family:var(--font-serif); font-variant-numeric: tabular-nums;">
          {conDocSinPriv} {lang === 'en' ? 'of' : 'de'} {totalUes} <span style="font-size:0.82rem; font-weight:600;">({pctSinPriv}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card2_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card2_desc')}
        </div>
      </div>

      <div style="background:var(--card-alt); border:1px solid var(--border-color); border-left:3px solid var(--text-muted); padding:1rem; border-radius:6px;">
        <div style="font-size:1.5rem; font-weight:700; color:var(--text-muted); font-family:var(--font-serif); font-variant-numeric: tabular-nums;">
          {sinDoc} {lang === 'en' ? 'of' : 'de'} {totalUes} <span style="font-size:0.82rem; font-weight:600;">({pctSinDoc}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card3_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card3_desc')}
        </div>
      </div>

    </div>

    <!-- Alerta Preventiva de Aplicación Práctica -->
    <div style="background:var(--card-alt); border-left:3px solid var(--accent-blue); padding:0.85rem 1.1rem; border-radius:4px; font-size:0.82rem; color:var(--text-main); line-height:1.5;">
      <strong>{lang === 'en' ? 'Preventive warning:' : lang === 'pt' ? 'Aviso preventivo:' : 'Advertencia preventiva:'}</strong> {t('kit.preventive_alert')}
    </div>

  </div>

  <!-- SECCIÓN: CUATRO REGLAS DE APLICACIÓN DIRECTA EN SÍLABOS (FORMATO EDITORIAL) -->
  <div style="margin-bottom:2.5rem;">
    <div style="margin-bottom:1.25rem;">
      <h3 style="font-size:1.35rem; margin-bottom:0.25rem; font-family:var(--font-serif);">
        {t('kit.rules_section_title')}
      </h3>
      <p style="font-size:0.88rem; color:var(--text-muted); margin:0;">
        {t('kit.rules_section_desc')}
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap:1.25rem;">
      
      <!-- Regla 1: Sílabo -->
      <div class="card" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.25rem;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <span class="badge badge-blue">{lang === 'en' ? 'For Your Classes' : lang === 'pt' ? 'Para Suas Aulas' : 'Para tus Clases'}</span>
            <span style="font-size:0.72rem; color:var(--text-muted); font-weight:600;">{lang === 'en' ? 'Course Syllabus' : lang === 'pt' ? 'Plano de Ensino' : 'Programa de Asignatura'}</span>
          </div>
          <h4 style="font-size:1.02rem; margin:0 0 0.35rem 0; color:var(--text-main);">
            {lang === 'en' ? '1. Course Syllabus Policy' : lang === 'pt' ? '1. Cláusula para o Plano de Ensino' : '1. Regla para el Sílabo del Curso'}
          </h4>
          <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 0.75rem 0; line-height:1.4;">
            {lang === 'en' ? 'Clearly defines permitted uses, mandatory prompt disclosure, and prohibits required paid tools.' : lang === 'pt' ? 'Define usos permitidos, dever de citar prompts e proíbe exigir ferramentas pagas.' : 'Define con claridad qué herramientas se autorizan, exige declarar prompts y prohíbe exigir plataformas de pago.'}
          </p>

          <!-- Texto de la regla en formato pliego (Tipografía Sans limpia, no terminal) -->
          <div id="texto-clausula-silabo" style="background:var(--card-alt); border:1px solid var(--border-color); border-radius:6px; padding:0.9rem; font-size:0.82rem; line-height:1.55; color:var(--text-main); white-space:pre-line;" set:html={lang === 'en' ? (
`<strong>Course Policy on AI Usage</strong>
In this course, generative AI is a learning support tool that never replaces critical student judgment.

1. <strong>Permitted uses:</strong> Brainstorming, drafting improvements, and debugging code (except in assessments specifically measuring that baseline skill).
2. <strong>Mandatory disclosure:</strong> All submitted work must include a brief declaration: tool used, main prompts, and human verification performed.
3. <strong>Academic integrity:</strong> Submitting text or code entirely generated by AI as one's own work constitutes an academic integrity violation.
4. <strong>Equity:</strong> No mandatory assessment will require paid-tier AI tools.`
          ) : lang === 'pt' ? (
`<strong>Política sobre Uso de IA na Disciplina</strong>
Neste curso, a inteligência artificial generativa é um recurso de apoio à aprendizagem que nunca substitui o julgamento crítico do estudante.

1. <strong>Usos permitidos:</strong> Exploração temática, aprimoramento de redação e depuração de código (salvo em avaliações que meçam expressamente essa competência básica).
2. <strong>Declaração obrigatória:</strong> Todo trabalho deve declarar em nota de rodapé: ferramenta empregada, prompts principais e verificação humana realizada.
3. <strong>Integridade acadêmica:</strong> Submeter texto ou código gerado integralmente por IA como de autoria própria constitui falta ética.
4. <strong>Equidade formativa:</strong> Nenhuma avaliação obrigatória exigirá ferramentas de IA sob modelo de assinatura paga.`
          ) : (
`<strong>Política sobre Uso de IA en la Asignatura</strong>
En este curso la inteligencia artificial generativa es una herramienta de apoyo al aprendizaje que nunca sustituye el juicio crítico del estudiante.

1. <strong>Usos permitidos:</strong> Exploración temática, corrección de redacción y depuración de código (salvo en evaluaciones que midan expresamente esa competencia básica).
2. <strong>Declaración obligatoria:</strong> Todo trabajo debe consignar al pie: herramienta empleada, prompts principales y verificación realizada sobre el resultado.
3. <strong>Integridad académica:</strong> Presentar texto o código generado íntegramente por IA como elaboración propia constituye falta a la ética formativa.
4. <strong>Equidad formativa:</strong> Ninguna evaluación obligatoria exigirá herramientas de IA bajo modelo de suscripción de pago.`
          )}></div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.85rem; padding-top:0.65rem; border-top:1px solid var(--border-color);">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-clausula" data-target="texto-clausula-silabo" style="font-size:0.76rem;">
            <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>{t('kit.btn_copy')}</span>
          </button>
          <span class="copy-feedback-badge" data-msg-copied={t('kit.copied')} data-msg-error={lang === 'en' ? 'Select text' : lang === 'pt' ? 'Selecionar texto' : 'Seleccionar texto'} style="font-size:0.74rem; color:var(--accent-green); font-weight:600; display:none;">
            ✓ {t('kit.copied')}
          </span>
        </div>
      </div>

      <!-- Regla 2: Tesis -->
      <div class="card" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.25rem;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <span class="badge badge-amber">{lang === 'en' ? 'Graduation & Postgrad' : lang === 'pt' ? 'Titulação & Pós-graduação' : 'Titulación & Postgrado'}</span>
            <span style="font-size:0.72rem; color:var(--text-muted); font-weight:600;">{lang === 'en' ? 'Theses & Dissertations' : lang === 'pt' ? 'Teses e Dissertações' : 'Tesis y Memorias'}</span>
          </div>
          <h4 style="font-size:1.02rem; margin:0 0 0.35rem 0; color:var(--text-main);">
            {lang === 'en' ? '2. Theses & Degree Work Rule' : lang === 'pt' ? '2. Diretriz para Teses e Monografias' : '2. Regla para Tesis y Memorias de Título'}
          </h4>
          <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 0.75rem 0; line-height:1.4;">
            {lang === 'en' ? 'States that authorship is strictly human, prohibits delegating analysis, and empowers oral defense interrogation.' : lang === 'pt' ? 'Esclarece que a autoria é exclusivamente humana, veda delegar análises e faculta arguição oral pela banca.' : 'Establece que la autoría es exclusivamente humana, veda delegar análisis interpretativos y faculta a la comisión a interrogar oralmente.'}
          </p>

          <div id="texto-clausula-tesis" style="background:var(--card-alt); border:1px solid var(--border-color); border-radius:6px; padding:0.9rem; font-size:0.82rem; line-height:1.55; color:var(--text-main); white-space:pre-line;" set:html={lang === 'en' ? (
`<strong>AI Usage in Degree Theses and Dissertations</strong>
In accordance with intellectual property regulations, authorship is strictly human. AI systems cannot be listed as authors or co-authors.

1. <strong>Methodological transparency:</strong> AI usage must be explicitly documented in the methodology chapter through an AI Usage Declaration.
2. <strong>No substantive delegation:</strong> Delegating hypothesis formulation, simulated empirical data, or primary findings interpretation to autonomous systems is strictly prohibited.
3. <strong>Oral defense and traceability:</strong> The evaluation committee is fully empowered to examine any formula, code, or argument presented, requiring candidates to demonstrate direct individual mastery.`
          ) : lang === 'pt' ? (
`<strong>Uso de IA em Trabalhos de Conclusão e Teses</strong>
Em conformidade com a legislação de propriedade intelectual, a autoria é estritamente humana. Sistemas de IA não podem figurar como autores ou coautores.

1. <strong>Transparência metodológica:</strong> O uso de IA deve ser explicitamente documentado no capítulo metodológico mediante Declaração de Uso de IA.
2. <strong>Não delegação substantiva:</strong> É proibido delegar em sistemas autônomos a formulação de hipóteses, dados empíricos simulados ou a interpretação central de resultados.
3. <strong>Arguição oral e rastreabilidade:</strong> A comissão examinadora tem plena autoridade para examinar qualquer fórmula, código ou argumento apresentado, devendo o pós-graduando demonstrar domínio direto e individual.`
          ) : (
`<strong>Uso de IA en Trabajos de Grado y Titulación</strong>
De conformidad con la Ley N° 17.336 sobre Propiedad Intelectual, la autoría es exclusivamente humana. La IA no puede figurar como autora ni coautora.

1. <strong>Transparencia metodológica:</strong> El uso de IA debe documentarse explícitamente en el capítulo metodológico mediante una Declaración de Uso de IA.
2. <strong>No delegación sustantiva:</strong> Queda prohibido delegar en sistemas autónomos la formulación de hipótesis, datos empíricos simulados o la interpretación central de resultados.
3. <strong>Defensa oral y trazabilidad:</strong> La comisión evaluadora está plenamente facultada para examinar cualquier fórmula, código o argumento presentado, debiendo el postulante acreditar dominio directo e individual.`
          )}></div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.85rem; padding-top:0.65rem; border-top:1px solid var(--border-color);">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-clausula" data-target="texto-clausula-tesis" style="font-size:0.76rem;">
            <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>{t('kit.btn_copy')}</span>
          </button>
          <span class="copy-feedback-badge" data-msg-copied={t('kit.copied')} data-msg-error={lang === 'en' ? 'Select text' : lang === 'pt' ? 'Selecionar texto' : 'Seleccionar texto'} style="font-size:0.74rem; color:var(--accent-green); font-weight:600; display:none;">
            ✓ {t('kit.copied')}
          </span>
        </div>
      </div>

      <!-- Regla 3: Privacidad Alumnos -->
      <div class="card" style="display:flex; flex-direction:column; justify-content:space-between; padding:1.25rem;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <span class="badge badge-green">{lang === 'en' ? 'Data Protection' : lang === 'pt' ? 'Proteção de Dados' : 'Protección de Datos'}</span>
            <span style="font-size:0.72rem; color:var(--text-muted); font-weight:600;">{lang === 'en' ? 'Privacy Law (Chile)' : lang === 'pt' ? 'Lei de Proteção de Dados' : 'Ley N° 21.719'}</span>
          </div>
          <h4 style="font-size:1.02rem; margin:0 0 0.35rem 0; color:var(--text-main);">
            {lang === 'en' ? '3. Safeguarding Student Data' : lang === 'pt' ? '3. Proteção de Dados de Alunos' : '3. Resguardo de Datos de Alumnos (Ley 21.719)'}
          </h4>
          <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 0.75rem 0; line-height:1.4;">
            {lang === 'en' ? 'Prohibits uploading names, student IDs, or grades to commercial AI platforms without enterprise privacy agreements.' : lang === 'pt' ? 'Veda upload de nomes, matrículas ou notas para plataformas de IA sem convênio corporativo.' : 'Prohíbe subir nombres, RUT o notas a servicios comerciales de IA sin convenio corporativo institucional con garantías de privacidad.'}
          </p>

          <div id="texto-clausula-privacidad" style="background:var(--card-alt); border:1px solid var(--border-color); border-radius:6px; padding:0.9rem; font-size:0.82rem; line-height:1.55; color:var(--text-main); white-space:pre-line;" set:html={lang === 'en' ? (
`<strong>Safeguarding Student Personal Data (Law No. 21,719)</strong>
1. <strong>Prohibition of unregulated transfer:</strong> Faculty and teaching assistants may not upload student rosters, names, IDs, grades, or personal records to open commercial AI platforms without institutional confidentiality and closed processing agreements.
2. <strong>Prior anonymization:</strong> Any student work sample or response utilized to draft rubrics or feedback must be subject to irreversible prior anonymization.
3. <strong>Legal enforceability:</strong> This requirement aligns with the mandatory enforcement of Chilean Personal Data Protection Law No. 21,719, effective December 1, 2026.`
          ) : lang === 'pt' ? (
`<strong>Salvaguarda de Dados Pessoais de Estudantes (Lei Nº 21.719)</strong>
1. <strong>Proibição de transferência não regulada:</strong> Professores e monitores não poderão carregar listas de chamada, nomes, números de documento, notas ou registros a plataformas comerciais de IA sem convênio institucional de confidencialidade.
2. <strong>Anonimização prévia:</strong> Qualquer amostra de trabalho ou resposta utilizada para elaborar rubricas ou feedbacks deve ser irreversivelmente anonimizada.
3. <strong>Exigibilidade legal:</strong> Essa salvaguarda alinha-se com a vigência obrigatória da Lei Nº 21.719 a contar de 1 de dezembro de 2026.`
          ) : (
`<strong>Resguardo de Datos Personales de Estudiantes (Ley N° 21.719)</strong>
1. <strong>Prohibición de transferencia no regulada:</strong> El cuerpo docente y de ayudantía no podrá cargar nóminas, nombres, RUT, calificaciones ni antecedentes a plataformas de IA abiertas o comerciales que no cuenten con convenio institucional de confidencialidad y procesamiento cerrado.
2. <strong>Anonimización previa:</strong> Cualquier muestra de trabajo o respuesta utilizada para elaborar rúbricas o retroalimentaciones debe ser sometida a anonimización irreversible.
3. <strong>Exigibilidad legal:</strong> Este resguardo se alinea con las exigencias vinculantes de la Ley N° 21.719, cuya vigencia obligatoria rige a contar del 1 de diciembre de 2026.`
          )}></div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.85rem; padding-top:0.65rem; border-top:1px solid var(--border-color);">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-clausula" data-target="texto-clausula-privacidad" style="font-size:0.76rem;">
            <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
