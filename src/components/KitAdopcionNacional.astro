---
// src/components/KitAdopcionNacional.astro
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import matrizData from '../../data/matriz_54_universidades.json';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const totalUes = matrizData.length; // 54
const conPrivacidad = matrizData.filter(u => u.dimensiones.privacidad_ley_21719).length; // 13
const conDocSinPriv = matrizData.filter(u => !u.en_brecha && !u.dimensiones.privacidad_ley_21719).length; // 19
const sinDoc = matrizData.filter(u => u.en_brecha).length; // 22

const pctPrivacidad = ((conPrivacidad / totalUes) * 100).toFixed(1); // 24.1%
const pctSinPriv = ((conDocSinPriv / totalUes) * 100).toFixed(1); // 35.2%
const pctSinDoc = ((sinDoc / totalUes) * 100).toFixed(1); // 40.7%

// Lista de universidades con cláusula de privacidad identificada en datos
const uesConPrivacidad = matrizData.filter(u => u.dimensiones.privacidad_ley_21719).map(u => u.sigla || u.nombre);
---

<section id="kit-adopcion" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.4rem;">
        <span class="badge badge-amber">{t('kit.badge_teachers')}</span>
        <span class="badge badge-blue">{t('kit.badge_countdown')}</span>
      </div>
      <h2 style="font-family: var(--font-serif); font-size: 1.85rem; margin: 0 0 0.5rem 0; color: var(--text-main);">
        {t('kit.title')}
      </h2>
      <p style="color:var(--text-muted); max-width:860px; font-size:0.96rem; line-height:1.55; margin: 0;">
        {t('kit.desc')}
      </p>
    </div>

    <!-- Enlaces de Descarga Rápida -->
    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap: wrap;">
      <a href="/kit_clausulas_docentes.md" download="kit_clausulas_ia_docentes.md" class="btn btn-primary btn-sm" style="font-size:0.82rem;">
        {t('kit.btn_download_clauses')}
      </a>
      <a href="/modelo_marco_orientaciones_ia_universidades.md" download="modelo_marco_ia_universidades_chile.md" class="btn btn-outline btn-sm" style="font-size:0.82rem;">
        {t('kit.btn_download_model')}
      </a>
    </div>
  </div>

  <!-- RADAR LEY N° 21.719: VIGENCIA OBLIGATORIA 1 DE DICIEMBRE DE 2026 -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; padding:1.5rem; margin-bottom:2rem; box-shadow:var(--shadow-sm); border-top:4px solid var(--accent-amber);">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.25rem;">
      <div>
        <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; color:var(--accent-amber); margin-bottom:0.35rem; letter-spacing:0.5px;">
          {t('kit.radar_badge')}
        </div>
        <h3 style="font-size:1.25rem; margin-bottom:0.35rem;">
          {t('kit.radar_title')}
        </h3>
        <p style="font-size:0.88rem; color:var(--text-muted); max-width:760px; line-height:1.5; margin:0;">
          {t('kit.radar_desc')}
        </p>
      </div>

      <!-- Contador / Hito Temporal -->
      <div style="background:rgba(217, 119, 6, 0.08); border:1px solid rgba(217, 119, 6, 0.25); padding:0.85rem 1.25rem; border-radius:8px; text-align:center;">
        <div style="font-size:0.75rem; font-weight:700; text-transform:uppercase; color:var(--accent-amber); letter-spacing:0.5px;">
          {t('kit.radar_vigencia_title')}
        </div>
        <div style="font-size:1.45rem; font-weight:700; font-family:var(--font-serif); color:var(--text-main);">
          {t('kit.radar_vigencia_date')}
        </div>
        <div style="font-size:0.74rem; color:var(--text-muted);">
          {t('kit.radar_vigencia_sub')}
        </div>
      </div>
    </div>

    <!-- Termómetro de Preparación Universitaria -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap:1rem; margin-bottom:1.25rem;">
      
      <div style="background:rgba(5, 150, 105, 0.05); border:1px solid rgba(5, 150, 105, 0.2); padding:1rem; border-radius:8px;">
        <div style="font-size:1.6rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif);">
          {conPrivacidad} {lang === 'en' ? 'of' : lang === 'pt' ? 'de' : 'de'} {totalUes} <span style="font-size:0.85rem; font-weight:600;">({pctPrivacidad}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card1_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card1_desc')}
        </div>
      </div>

      <div style="background:rgba(217, 119, 6, 0.05); border:1px solid rgba(217, 119, 6, 0.2); padding:1rem; border-radius:8px;">
        <div style="font-size:1.6rem; font-weight:700; color:var(--accent-amber); font-family:var(--font-serif);">
          {conDocSinPriv} {lang === 'en' ? 'of' : lang === 'pt' ? 'de' : 'de'} {totalUes} <span style="font-size:0.85rem; font-weight:600;">({pctSinPriv}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card2_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card2_desc')}
        </div>
      </div>

      <div style="background:rgba(0, 0, 0, 0.03); border:1px solid var(--border-color); padding:1rem; border-radius:8px;">
        <div style="font-size:1.6rem; font-weight:700; color:var(--text-muted); font-family:var(--font-serif);">
          {sinDoc} {lang === 'en' ? 'of' : lang === 'pt' ? 'de' : 'de'} {totalUes} <span style="font-size:0.85rem; font-weight:600;">({pctSinDoc}%)</span>
        </div>
        <div style="font-weight:600; font-size:0.82rem; color:var(--text-main); margin-top:0.25rem;">
          {t('kit.card3_title')}
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted); margin-top:0.2rem; line-height:1.35;">
          {t('kit.card3_desc')}
        </div>
      </div>

    </div>

    <!-- Alerta Metodológica para Vicerrectorías Jurídicas -->
    <div style="background:rgba(0,0,0,0.02); border-left:3px solid var(--accent-blue); padding:0.85rem 1rem; border-radius:0 6px 6px 0; font-size:0.82rem; color:var(--text-main); line-height:1.5;">
      <strong>{lang === 'en' ? 'Preventive Guidance:' : lang === 'pt' ? 'Orientação Preventiva:' : 'Orientación Preventiva:'}</strong> {t('kit.preventive_alert')}
    </div>

  </div>

  <!-- 4 REGLAS LISTAS PARA COPIAR EN TUS CLASES (UN CLIC) -->
  <div style="margin-bottom: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
      <div>
        <h3 style="font-size: 1.35rem; margin: 0 0 0.25rem 0; font-family: var(--font-serif); color: var(--text-main);">
          {t('kit.rules_section_title')}
        </h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          {t('kit.rules_section_desc')}
        </p>
      </div>
      <span class="badge badge-green">Licencia Abierta CC BY 4.0</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 1.25rem;">
      
      <!-- Bloque 1: Sílabo -->
      <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="badge badge-blue">{lang === 'en' ? 'For Your Classes' : lang === 'pt' ? 'Para Suas Aulas' : 'Para tus Clases'}</span>
            <span style="font-size: 0.74rem; color: var(--text-muted);">{lang === 'en' ? 'Course Syllabus' : lang === 'pt' ? 'Plano de Ensino' : 'Programa de Curso'}</span>
          </div>
          <h4 style="font-size: 1.05rem; margin: 0 0 0.4rem 0; color: var(--text-main);">
            {lang === 'en' ? '1. Course Syllabus Policy' : lang === 'pt' ? '1. Cláusula para o Plano de Ensino' : '1. Regla para el Sílabo del Curso'}
          </h4>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem 0;">
            {lang === 'en' ? 'Clearly defines permitted uses, mandatory prompt disclosure, and prohibits required paid tools.' : lang === 'pt' ? 'Define usos permitidos, dever de citar prompts e proíbe exigir ferramentas pagas.' : 'Define claramente qué se puede usar, la obligación de citar los prompts y prohíbe exigir herramientas de pago.'}
          </p>
          <textarea id="texto-clausula-silabo" readonly rows="6" style="width: 100%; font-family: monospace; font-size: 0.75rem; padding: 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--canvas-bg); color: var(--text-main); resize: vertical; box-sizing: border-box;">### Política sobre Uso de IA en la Asignatura
En este curso la IA generativa es un apoyo al aprendizaje que nunca sustituye el juicio crítico del estudiante.
1. Usos permitidos: Lluvia de ideas, corrección de redacción y depuración de código (salvo cuando la evaluación mida esa habilidad básica).
2. Declaración obligatoria: Todo trabajo debe incluir al pie: herramienta usada, prompts utilizados y cómo se validó el resultado.
3. Integridad: Entregar texto o código generado íntegramente por IA como propio constituye falta grave.
4. Equidad: Ninguna evaluación obligatoria exigirá herramientas de pago.</textarea>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-rapido" data-target="texto-clausula-silabo" style="font-size: 0.78rem;">
            {t('kit.btn_copy')}
          </button>
          <span class="copy-feedback-badge" style="font-size: 0.74rem; color: var(--accent-green); font-weight: 600; display: none;">{t('kit.copied')}</span>
        </div>
      </div>

      <!-- Bloque 2: Tesis -->
      <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="badge badge-amber">{lang === 'en' ? 'Graduation' : lang === 'pt' ? 'Titulação' : 'Titulación'}</span>
            <span style="font-size: 0.74rem; color: var(--text-muted);">{lang === 'en' ? 'Theses & Dissertations' : lang === 'pt' ? 'Teses e Dissertações' : 'Tesis y Memorias'}</span>
          </div>
          <h4 style="font-size: 1.05rem; margin: 0 0 0.4rem 0; color: var(--text-main);">
            {lang === 'en' ? '2. Thesis & Degree Work Rule' : lang === 'pt' ? '2. Diretriz para Teses e Monografias' : '2. Regla para Tesis y Memorias de Título'}
          </h4>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem 0;">
            {lang === 'en' ? 'Clarifies AI is not an author, prohibits delegating analysis, and empowers oral defense interrogation.' : lang === 'pt' ? 'Esclarece que a IA não é autora, veda delegar análises e faculta arguição oral pela banca.' : 'Aclara que la IA no es autor, prohíbe delegar el análisis y faculta a la comisión a interrogar oralmente.'}
          </p>
          <textarea id="texto-clausula-tesis" readonly rows="6" style="width: 100%; font-family: monospace; font-size: 0.75rem; padding: 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--canvas-bg); color: var(--text-main); resize: vertical; box-sizing: border-box;">### Uso de IA en Trabajos de Grado y Titulación
Según la Ley N° 17.336, la autoría es exclusivamente humana. La IA nunca podrá figurar como autora ni coautora.
1. Transparencia: El uso de IA debe documentarse en la metodología en una "Declaración de Uso de IA".
2. No delegación: Prohibido delegar en IA hipótesis, datos simulados o el análisis interpretativo central.
3. Defensa oral: La comisión evaluadora está facultada para interrogar sobre cualquier fórmula, código o fuente del documento, debiendo el estudiante demostrar dominio directo.</textarea>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-rapido" data-target="texto-clausula-tesis" style="font-size: 0.78rem;">
            {t('kit.btn_copy')}
          </button>
          <span class="copy-feedback-badge" style="font-size: 0.74rem; color: var(--accent-green); font-weight: 600; display: none;">{t('kit.copied')}</span>
        </div>
      </div>

      <!-- Bloque 3: Privacidad Alumnos -->
      <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="badge badge-green">{lang === 'en' ? 'Legal & Privacy' : lang === 'pt' ? 'Legal e Privacidade' : 'Legal & Privacidad'}</span>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Ley N° 21.719</span>
          </div>
          <h4 style="font-size: 1.05rem; margin: 0 0 0.4rem 0; color: var(--text-main);">
            {lang === 'en' ? '3. Student Data Protection (Law 21,719)' : lang === 'pt' ? '3. Proteção de Dados de Estudantes (Lei 21.719)' : '3. Cuidado de Datos de Alumnos (Ley 21.719)'}
          </h4>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem 0;">
            {lang === 'en' ? 'Prohibits uploading names, student IDs, or grades to commercial AI platforms without enterprise agreements.' : lang === 'pt' ? 'Veda upload de nomes, IDs ou notas para plataformas comerciais de IA sem convênio corporativo.' : 'Prohíbe subir nombres, RUT o notas a ChatGPT u otras IA comerciales sin convenio corporativo de privacidad.'}
          </p>
          <textarea id="texto-clausula-privacidad" readonly rows="6" style="width: 100%; font-family: monospace; font-size: 0.75rem; padding: 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--canvas-bg); color: var(--text-main); resize: vertical; box-sizing: border-box;">### Resguardo de Datos Personales de Estudiantes (Ley N° 21.719)
1. Prohibición estricta: Docentes y ayudantes no podrán subir nóminas, nombres, RUT, notas o datos personales a plataformas de IA comerciales o abiertas sin convenio corporativo institucional.
2. Anonimización: Cualquier respuesta o caso utilizado para generar rúbricas debe anonimizarse irreversiblemente de forma previa.
3. Exigibilidad: Esta obligación rige con fuerza de ley obligatoria a contar del 1 de diciembre de 2026.</textarea>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-rapido" data-target="texto-clausula-privacidad" style="font-size: 0.78rem;">
            {t('kit.btn_copy')}
          </button>
          <span class="copy-feedback-badge" style="font-size: 0.74rem; color: var(--accent-green); font-weight: 600; display: none;">{t('kit.copied')}</span>
        </div>
      </div>

      <!-- Bloque 4: Criterios Evaluativos -->
      <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="badge" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.25);">{lang === 'en' ? 'Pedagogy' : lang === 'pt' ? 'Pedagogia' : 'Pedagogía'}</span>
            <span style="font-size: 0.74rem; color: var(--text-muted);">{lang === 'en' ? 'Assessment Design' : lang === 'pt' ? 'Design de Avaliações' : 'Diseño de Pruebas'}</span>
          </div>
          <h4 style="font-size: 1.05rem; margin: 0 0 0.4rem 0; color: var(--text-main);">
            {lang === 'en' ? '4. Assessment Redesign Criteria' : lang === 'pt' ? '4. Critérios para Desenho Avaliativo' : '4. Criterios para Diseñar Evaluaciones'}
          </h4>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.75rem 0;">
            {lang === 'en' ? 'Focuses on formative process and oral defense, strictly prohibiting sanctions based solely on AI detectors.' : lang === 'pt' ? 'Enfatiza o processo e defesas orais, vedando punir estudantes exclusivamente por detectores automáticos.' : 'Enseña a evaluar el proceso y la defensa oral, prohibiendo castigar alumnos usando detectores automáticos.'}
          </p>
          <textarea id="texto-clausula-evaluacion" readonly rows="6" style="width: 100%; font-family: monospace; font-size: 0.75rem; padding: 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--canvas-bg); color: var(--text-main); resize: vertical; box-sizing: border-box;">### Criterios Docentes para Evaluar con IA
1. Evaluar el proceso: Privilegiar bitácoras de trabajo, borradores intermedios y defensas orales cortas por sobre informes estáticos.
2. Prohibición de detectores automáticos de IA: Dada su alta tasa comprobada de falsos positivos, ninguna sanción podrá basarse únicamente en detectores automáticos.
3. Buena fe formativa: Ante sospechas de copia indebida, la primera instancia será siempre una entrevista pedagógica personal.</textarea>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
          <button type="button" class="btn btn-outline btn-sm btn-copiar-rapido" data-target="texto-clausula-evaluacion" style="font-size: 0.78rem;">
            {t('kit.btn_copy')}
          </button>
          <span class="copy-feedback-badge" style="font-size: 0.74rem; color: var(--accent-green); font-weight: 600; display: none;">{t('kit.copied')}</span>
        </div>
      </div>

    </div>
  </div>

  <!-- PLANTILLA MARCO ABIERTA (DESCARGABLE Y COPIABLE) -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; padding:1.5rem; box-shadow:var(--shadow-sm); border-top:4px solid var(--accent-green);">
    
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; color:var(--accent-green); margin-bottom:0.25rem; letter-spacing:0.5px;">
          📄 Modelo Marco Institucional
        </div>
        <h3 style="font-size:1.25rem; margin-bottom:0.25rem;">
          Lineamientos de IA para la Docencia Universitaria
        </h3>
        <p style="font-size:0.86rem; color:var(--text-muted); margin:0;">
          Redacción jurídica estándar en formato de Resolución de Rectoría / Vicerrectoría, construida sobre el consenso de las 32 normativas chilenas vigentes.
        </p>
      </div>

      <div style="display:flex; gap:0.5rem;">
        <span class="badge badge-green">Licencia Abierta CC BY 4.0</span>
        <span class="badge badge-blue">Formato Markdown & Texto</span>
      </div>
    </div>

    <!-- Previsualización de los 6 Títulos Clave en Acordeón Ligero -->
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem;">
      
      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;" open>
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título I: Principios Orientadores (Intencionalidad Pedagógica, Transparencia y Equidad)
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          La IA se define como un recurso de apoyo que complementa y nunca sustituye el juicio crítico humano. Prohíbe exigir para aprobar herramientas de IA con suscripción de pago (garantía de gratuidad y equidad).
        </p>
      </details>

      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;">
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título II: Integridad Académica y Regla Canónica de Autoría
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          De conformidad con la Ley N° 17.336 de Propiedad Intelectual, la IA carece de personalidad jurídica y moral, por lo que nunca puede figurar como autor ni coautor. Se establece la obligatoriedad de adjuntar una <em>Declaración de Uso de IA y Prompts</em> en evaluaciones.
        </p>
      </details>

      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;">
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título III: Criterios para el Diseño de Evaluaciones
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          Instruye a privilegiar evaluaciones procesuales, defensas orales y análisis situados por sobre exámenes memorísticos. <strong>Prohíbe usar detectores automáticos de IA como prueba única o determinante de plagio</strong>, dada su tasa de falsos positivos demostrada.
        </p>
      </details>

      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;">
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título IV: Protección de Datos y Privacidad (Ley N° 21.719)
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          Prohibición taxativa de alimentar plataformas de IA con datos personales de estudiantes o funcionarios (nombres, RUT, calificaciones, antecedentes de salud). Exigencia de anonimización irreversible en proyectos de investigación.
        </p>
      </details>

      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;">
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título V: Trabajos de Titulación, Tesis de Grado y Memorias
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          Autoriza el uso de IA como apoyo exploratorio o estilístico con declaración detallada en la metodología de la tesis. Prohíbe delegar hipótesis, datos simulados o interpretación de resultados. Faculta a la comisión a interrogar oralmente sobre la trazabilidad.
        </p>
      </details>

      <details style="background:var(--canvas-bg); border:1px solid var(--border-color); border-radius:6px; padding:0.75rem 1rem;">
        <summary style="font-weight:600; font-size:0.9rem; cursor:pointer; color:var(--text-main);">
          Título VI: Régimen Disciplinario Proporcional y Buena Fe Formativa
        </summary>
        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.5rem; line-height:1.5;">
          Tipifica el fraude por IA no declarada. Establece la presunción de buena fe formativa: la primera instancia frente a sospechas es una entrevista pedagógica con el docente, reservando sumarios disciplinarios para fraude reiterado.
        </p>
      </details>

    </div>

    <!-- Caja de Código / Texto Completo Copiable -->
    <div style="position:relative;">
      <div style="display:flex; justify-content:space-between; align-items:center; background:var(--card-alt); padding:0.6rem 1rem; border-radius:6px 6px 0 0; border:1px solid var(--border-color); border-bottom:none;">
        <span style="font-size:0.76rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">
          Texto Completo del Modelo (Listo para copiar y adaptar)
        </span>
        <span id="copy-status" style="font-size:0.76rem; color:var(--accent-green); font-weight:600; display:none;">
          ✓ ¡Copiado al portapapeles!
        </span>
      </div>
      <textarea 
        id="textarea-modelo-marco" 
        readonly 
        rows="12" 
        style="width:100%; padding:1rem; font-family:monospace; font-size:0.78rem; line-height:1.5; background:var(--canvas-bg); color:var(--text-main); border:1px solid var(--border-color); border-radius:0 0 6px 6px; resize:vertical; box-sizing:border-box;"
      ># MODELO MARCO DE LINEAMIENTOS INSTITUCIONALES PARA EL USO ÉTICO Y FORMATIVO DE LA INTELIGENCIA ARTIFICIAL EN LA DOCENCIA UNIVERSITARIA

RESOLUCIÓN / DECRETO N° [XXX]

VISTOS:
1. Las facultades conferidas por el Estatuto de la Universidad [Nombre].
2. La Ley N° 21.091 sobre Educación Superior.
3. La Ley N° 17.336 sobre Propiedad Intelectual.
4. La Ley N° 21.719 sobre Protección de Datos Personales (vigente a contar del 1 de diciembre de 2026).

CONSIDERANDO:
1. Que la inteligencia artificial generativa representa una transformación en los procesos de creación y aprendizaje.
2. Que la misión formativa exige cautelar el pensamiento crítico, la autoría humana y la responsabilidad ética.

RESUELVO:

TÍTULO I: DISPOSICIONES GENERALES Y PRINCIPIOS
Artículo 1. Objeto: Rige el uso de sistemas de IA en pregrado, postgrado y titulación.
Artículo 2. Principios: Intencionalidad Pedagógica, Transparencia, Equidad (no exigir herramientas de pago) y Resguardo estricto de Privacidad.

TÍTULO II: INTEGRIDAD ACADÉMICA Y AUTORÍA
Artículo 3. Autoría: La IA carece de personalidad jurídica. En ningún caso puede figurar como autora ni coautora.
Artículo 4. Declaración de Uso: Los estudiantes deberán adjuntar breve declaración de herramientas, prompts y finalidad de uso.

TÍTULO III: DISEÑO DE EVALUACIONES
Artículo 5. Criterios Docentes: Privilegiar evaluaciones de proceso y orales. Prohibición de usar detectores automáticos de IA como prueba única de plagio.

TÍTULO IV: PROTECCIÓN DE DATOS (LEY N° 21.719)
Artículo 6. Deber de Confidencialidad: Prohibido ingresar nombres, RUT, notas o datos sensibles a modelos de IA comerciales o abiertos.

TÍTULO V: TESIS Y MEMORIAS
Artículo 7. Trabajos de Grado: Permitido para apoyo estilístico/búsqueda con declaración en metodología. Prohibido delegar hipótesis o interpretación. Comisión facultada a interrogar oralmente.

TÍTULO VI: RÉGIMEN DISCIPLINARIO
Artículo 8. Tipificación: Presentar producción no declarada constituye falta.
Artículo 9. Buena Fe Formativa: La primera instancia es una entrevista formativa; procesos disciplinarios para fraude reiterado.

Artículo Transitorio: Constitución de Mesa Técnica Permanente de IA.
Comuníquese, publíquese y archívese.</textarea>
