<script is:inline>
  // Copiar modelo institucional completo
  const copyBtn = document.getElementById('btn-copiar-modelo');
  const copyStatus = document.getElementById('copy-status');
  const textarea = document.getElementById('textarea-modelo-marco');

  copyBtn?.addEventListener('click', async () => {
    if (!textarea) return;
    try {
      await navigator.clipboard.writeText(textarea.value);
      if (copyStatus) {
        copyStatus.style.display = 'inline';
        setTimeout(() => { copyStatus.style.display = 'none'; }, 3000);
      }
    } catch (e) {
      textarea.select();
      document.execCommand('copy');
      if (copyStatus) {
        copyStatus.style.display = 'inline';
        setTimeout(() => { copyStatus.style.display = 'none'; }, 3000);
      }
    }
  });

  // Copiar micro-bloques individuales de 1 clic
  const rapidButtons = document.querySelectorAll('.btn-copiar-rapido');
  rapidButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-target');
      const targetEl = document.getElementById(targetId);
      const parent = btn.parentElement;
      const feedback = parent?.querySelector('.copy-feedback-badge');

      if (!targetEl) return;
      const textToCopy = targetEl.value || targetEl.textContent;

      try {
        await navigator.clipboard.writeText(textToCopy);
        if (feedback) {
          feedback.style.display = 'inline';
          setTimeout(() => { feedback.style.display = 'none'; }, 3000);
        }
      } catch (err) {
        targetEl.select();
        document.execCommand('copy');
        if (feedback) {
          feedback.style.display = 'inline';
          setTimeout(() => { feedback.style.display = 'none'; }, 3000);
        }
      }
    });
  });
</script>
