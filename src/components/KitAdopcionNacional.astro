<script is:inline>
  // Copiar micro-bloques individuales de reglas
  document.querySelectorAll('.btn-copiar-clausula').forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-target');
      const targetEl = document.getElementById(targetId);
      const parent = btn.parentElement;
      const feedback = parent ? parent.querySelector('.copy-feedback-badge') : null;

      if (!targetEl) return;
      const textToCopy = targetEl.innerText || targetEl.textContent || '';

      let success = false;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy.trim());
          success = true;
        } else {
          throw new Error('Clipboard API no disponible');
        }
      } catch (err) {
        // Fallback mediante selección y execCommand
        try {
          const ta = document.createElement('textarea');
          ta.value = textToCopy.trim();
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          success = document.execCommand('copy');
          document.body.removeChild(ta);
        } catch (_) {
          success = false;
        }
      }

      if (feedback) {
        const msgCopied = feedback.getAttribute('data-msg-copied') || '✓ Copiado';
        const msgError = feedback.getAttribute('data-msg-error') || 'Seleccionar texto';
        if (success) {
          feedback.style.display = 'inline';
          feedback.textContent = msgCopied.startsWith('✓') ? msgCopied : `✓ ${msgCopied}`;
          feedback.style.color = 'var(--accent-green)';
          setTimeout(() => { feedback.style.display = 'none'; }, 3000);
        } else {
          feedback.style.display = 'inline';
          feedback.textContent = msgError;
          feedback.style.color = 'var(--accent-amber)';
          setTimeout(() => { feedback.style.display = 'none'; }, 3000);
        }
      }
    });
  });

  // Copiar modelo marco institucional completo con fallback robusto
  const copyModeloBtn = document.getElementById('btn-copiar-modelo');
  const copyModeloText = document.getElementById('copy-modelo-text');
  const modeloContent = document.getElementById('contenedor-texto-modelo');

  copyModeloBtn?.addEventListener('click', async () => {
    if (!modeloContent) return;
    const text = modeloContent.innerText || modeloContent.textContent || '';
    const originalText = copyModeloText ? copyModeloText.textContent : '';
    let success = false;

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text.trim());
        success = true;
      } else {
        throw new Error('Clipboard API no disponible');
      }
    } catch (e) {
      // Fallback seguro mediante textarea temporal
      try {
        const ta = document.createElement('textarea');
        ta.value = text.trim();
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        success = document.execCommand('copy');
        document.body.removeChild(ta);
      } catch (errFallback) {
        success = false;
      }
    }

    if (copyModeloText) {
      const msgCopied = copyModeloBtn?.getAttribute('data-msg-copied') || '✓ ¡Copiado!';
      const msgError = copyModeloBtn?.getAttribute('data-msg-error') || 'Error al copiar';
      if (success) {
        copyModeloText.textContent = msgCopied;
        setTimeout(() => { copyModeloText.textContent = originalText; }, 3000);
      } else {
        copyModeloText.textContent = msgError;
        setTimeout(() => { copyModeloText.textContent = originalText; }, 3000);
      }
    }
  });
</script>
