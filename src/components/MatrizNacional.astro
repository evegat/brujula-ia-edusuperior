---
import matrizData from '../../data/matriz_54_universidades.json';

const totalOficiales = matrizData.length; // 54
const conInstrumento = matrizData.filter(u => !u.en_brecha).length; // 32
const enBrecha = matrizData.filter(u => u.en_brecha).length; // 22
const porcentajeCobertura = ((conInstrumento / totalOficiales) * 100).toFixed(1); // 59.3%
const conCompras = matrizData.filter(u => u.dimensiones.compras_ia).length; // 10
const brechaConCompras = matrizData.filter(u => u.en_brecha && u.dimensiones.compras_ia).length; // 3 (UTEM, ULS, UBB)

function normalizeForSearch(str: string): string {
  return (str || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}
---

<section id="matriz-nacional" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.4rem;">
        <span class="badge badge-green">Censo Canónico Oficial</span>
        <span class="badge badge-blue">Nómina Mineduc / SIES (Mayo 2026)</span>
      </div>
      <h2>Matriz Nacional de las 54 Universidades de Chile</h2>
      <p style="color:var(--text-muted); max-width:820px; font-size:0.96rem;">
        Auditoría empírica y semáforo dimensional sobre los 54 planteles universitarios reconocidos oficialmente en el país. Cruce de instrumentos normativos, compras públicas y brechas regulatorias.
      </p>
    </div>

    <!-- Indicador de Cobertura General -->
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:1rem 1.5rem; border-radius:12px; text-align:right; box-shadow:var(--shadow-sm);">
      <div style="font-size:2rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif); line-height:1;">
        {porcentajeCobertura}%
      </div>
      <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.25rem;">
        {conInstrumento} con instrumento / {enBrecha} en brecha
      </div>
    </div>
  </div>

  <!-- Tarjetas KPI del Censo -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap:1rem; margin-bottom:2rem;">
    <div class="card" style="padding:1.2rem; text-align:center;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--text-main); font-family:var(--font-serif);">{totalOficiales}</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">Universidades Oficiales</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--accent-green);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif);">{conInstrumento} (59.3%)</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">Con Instrumento Verificado</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--accent-red);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-red); font-family:var(--font-serif);">{enBrecha} (40.7%)</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">En Brecha Regulatoria</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--accent-amber);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-amber); font-family:var(--font-serif);">{conCompras} Planteles</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">Compras IA Mercado Público ({brechaConCompras} en brecha)</div>
    </div>
  </div>

  <!-- Barra de Filtros y Búsqueda -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; padding:1.25rem; margin-bottom:1.5rem; box-shadow:var(--shadow-sm);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem;">
      
      <!-- Filtros por tipo de institución -->
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="matriz-filter-buttons">
        <button type="button" class="btn btn-primary btn-sm matriz-btn-f" data-filter="todas">
          Todas ({totalOficiales})
        </button>
        <button type="button" class="btn btn-outline btn-sm matriz-btn-f" data-filter="Estatales">
          🏛️ Estatales (18)
        </button>
        <button type="button" class="btn btn-outline btn-sm matriz-btn-f" data-filter="Privadas CRUCH">
          🎓 Privadas CRUCH (9)
        </button>
        <button type="button" class="btn btn-outline btn-sm matriz-btn-f" data-filter="Privadas no CRUCH">
          🏢 Privadas no CRUCH (27)
        </button>
        <button type="button" class="btn btn-outline btn-sm matriz-btn-f" data-filter="con-instrumento" style="color:var(--accent-green);">
          ✓ Con Instrumento ({conInstrumento})
        </button>
        <button type="button" class="btn btn-outline btn-sm matriz-btn-f" data-filter="en-brecha" style="color:var(--accent-red);">
          ⚠️ En Brecha ({enBrecha})
        </button>
      </div>

      <!-- Buscador de la Matriz -->
      <div style="min-width:260px; flex:1; max-width:380px;">
        <input 
          type="text" 
          id="matriz-search-input" 
          placeholder="🔍 Filtrar por nombre, sigla o tipo..."
          style="width:100%; padding:0.5rem 0.85rem; border:1px solid var(--border-color); border-radius:6px; background:var(--canvas-bg); color:var(--text-main); font-size:0.85rem;"
        />
      </div>

    </div>

    <!-- Contador de Resultados -->
    <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.82rem; color:var(--text-muted); border-top:1px solid var(--border-color); padding-top:0.75rem;">
      <span id="matriz-count-display">Mostrando 54 de 54 planteles universitarios</span>
      <span style="font-size:0.78rem;">6 Dimensiones de Diagnóstico</span>
    </div>
  </div>

  <!-- Leyenda de las 6 Dimensiones -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.5rem; margin-bottom:1.5rem; font-size:0.78rem; background:rgba(0,0,0,0.02); padding:0.75rem 1rem; border-radius:8px; border:1px solid var(--border-color);">
    <div><strong>1. Aula:</strong> Protocolo formativo de aula</div>
    <div><strong>2. Tesis:</strong> Directriz de tesis / postgrado</div>
    <div><strong>3. Autoría:</strong> IA no es autora de obras</div>
    <div><strong>4. Privacidad:</strong> Cláusula Ley N° 21.719</div>
    <div><strong>5. Evaluación:</strong> Rediseño evaluativo</div>
    <div><strong>6. Compras:</strong> Licitaciones IA en ChileCompra</div>
  </div>

  <!-- Grilla de Tarjetas de la Matriz (Prerenderizada por SSR para SEO & No-JS) -->
  <div id="matriz-cards-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap:1.25rem;">
    {matrizData.map((u) => {
      const dims = u.dimensiones;
      const searchBlob = `${normalizeForSearch(u.nombre)} ${normalizeForSearch(u.sigla)} ${normalizeForSearch(u.tipo_oficial)} ${normalizeForSearch(u.tipo_categoria)}`;
      
      return (
        <div 
          class="card matriz-card"
          data-tipo-categoria={u.tipo_categoria}
          data-en-brecha={u.en_brecha ? 'true' : 'false'}
          data-search={searchBlob}
          style={`display:flex; flex-direction:column; justify-content:space-between; border-top: 3px solid ${u.en_brecha ? 'var(--accent-red)' : 'var(--accent-green)'};`}
        >
          <div>
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem; gap:0.5rem;">
              <div style="display:flex; gap:0.4rem; align-items:center;">
                <span class={`badge ${u.en_brecha ? 'badge-red' : 'badge-green'}`}>
                  {u.en_brecha ? '⚠️ En Brecha' : '✓ Con Instrumento'}
                </span>
                <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">{u.registro}</span>
              </div>
              {u.imn && <span class="badge badge-blue">IMN {u.imn}/100</span>}
            </div>

            <h3 style="font-size:1.05rem; line-height:1.3; margin-bottom:0.35rem;">
              {u.nombre}
            </h3>

            <div style="display:flex; gap:0.5rem; align-items:center; font-size:0.78rem; color:var(--text-muted); margin-bottom:1rem;">
              <span>{u.tipo_categoria}</span>
              <span>•</span>
              <span>{u.total_instrumentos} doc(s) identificado(s)</span>
            </div>

            <!-- Semáforo de las 6 dimensiones -->
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.4rem; background:rgba(0,0,0,0.02); padding:0.6rem 0.75rem; border-radius:6px; font-size:0.76rem; margin-bottom:1.1rem; border:1px solid var(--border-color);">
              <div>
                {dims.protocolo_aula ? (
                  <span title="Protocolo de Aula Verificado" style="color:var(--accent-green); font-weight:600;">✓ Aula</span>
                ) : (
                  <span title="Sin Protocolo de Aula" style="color:var(--accent-red); font-weight:600;">⚠️ Aula</span>
                )}
              </div>
              <div>
                {dims.directriz_tesis ? (
                  <span title="Directriz de Tesis Verificada" style="color:var(--accent-green);">✓ Tesis</span>
                ) : (
                  <span title="Sin directriz de tesis" style="color:var(--text-muted); opacity:0.6;">— Tesis</span>
                )}
              </div>
              <div>
                {dims.regla_autoria ? (
                  <span title="IA no es autora" style="color:var(--accent-green);">✓ Autoría</span>
                ) : (
                  <span title="Sin regla de autoría" style="color:var(--text-muted); opacity:0.6;">— Autoría</span>
                )}
              </div>
              <div>
                {dims.privacidad_ley_21719 ? (
                  <span title="Protección de Datos Ley 21.719" style="color:var(--accent-green);">✓ Datos</span>
                ) : (
                  <span title="Sin mención de datos" style="color:var(--text-muted); opacity:0.6;">— Datos</span>
                )}
              </div>
              <div>
                {dims.modifica_evaluacion ? (
                  <span title="Modifica Evaluaciones" style="color:var(--accent-green);">✓ Eval</span>
                ) : (
                  <span title="Sin cambio evaluativo" style="color:var(--text-muted); opacity:0.6;">— Eval</span>
                )}
              </div>
              <div>
                {dims.compras_ia ? (
                  <span title={`${u.compras?.total || 0} contratos en Mercado Público`} style="color:var(--accent-amber); font-weight:700;">
                    💰 Compras ({u.compras?.total || 0})
                  </span>
                ) : (
                  <span style="color:var(--text-muted); opacity:0.5;">— Compras</span>
                )}
              </div>
            </div>
          </div>

          <div style="border-top:1px solid var(--border-color); padding-top:0.85rem; margin-top:0.5rem;">
            {u.en_brecha ? (
              <button 
                type="button" 
                class="btn btn-outline btn-sm btn-aporte-directo" 
                data-universidad={encodeURIComponent(u.nombre)}
                style="width:100%; color:var(--accent-blue); border-color:var(--accent-blue); font-size:0.8rem;"
              >
                ✍️ ¿Conoces la normativa de este plantel? Aportar antecedente
              </button>
            ) : (
              <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.8rem;">
                <span style="color:var(--accent-green); font-weight:600;">Instrumento en catastro</span>
                <a href="#catalogo" style="color:var(--accent-blue); font-weight:600; font-size:0.78rem;">Ver en catálogo &rarr;</a>
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Estado Vacío -->
  <div id="matriz-empty-state" style="display:none; text-align:center; padding:3.5rem 1.5rem; background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; margin-top:1rem;">
    <div style="font-size:2.5rem; margin-bottom:0.75rem;">🔍</div>
    <h3 style="font-size:1.3rem; margin-bottom:0.5rem;">No se encontraron planteles con ese criterio</h3>
    <p style="color:var(--text-muted); font-size:0.9rem; max-width:480px; margin:0 auto 1.5rem auto;">
      No hay universidades que coincidan con la búsqueda actual. Puedes restablecer los filtros para volver a ver el censo completo.
    </p>
    <button type="button" id="matriz-reset-btn" class="btn btn-primary">
      🔄 Limpiar Filtros y Ver Todas ({totalOficiales})
    </button>
  </div>

</section>

<script is:inline>
  let filtroActual = 'todas';
  let busquedaActual = '';

  const grid = document.getElementById('matriz-cards-grid');
  const cards = Array.from(document.querySelectorAll('.matriz-card'));
  const emptyState = document.getElementById('matriz-empty-state');
  const countDisplay = document.getElementById('matriz-count-display');
  const searchInput = document.getElementById('matriz-search-input');
  const resetBtn = document.getElementById('matriz-reset-btn');

  function normalizeInput(str) {
    return (str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function filtrarMatriz() {
    if (!grid || cards.length === 0) return;

    const normQuery = normalizeInput(busquedaActual);
    let visibles = 0;

    cards.forEach(card => {
      const tipo = card.getAttribute('data-tipo-categoria');
      const enBrecha = card.getAttribute('data-en-brecha') === 'true';
      const searchBlob = card.getAttribute('data-search') || '';

      // 1. Filtro por tipo o brecha
      let matchCategoria = true;
      if (filtroActual === 'Estatales' && tipo !== 'Estatales') matchCategoria = false;
      if (filtroActual === 'Privadas CRUCH' && tipo !== 'Privadas CRUCH') matchCategoria = false;
      if (filtroActual === 'Privadas no CRUCH' && tipo !== 'Privadas no CRUCH') matchCategoria = false;
      if (filtroActual === 'con-instrumento' && enBrecha) matchCategoria = false;
      if (filtroActual === 'en-brecha' && !enBrecha) matchCategoria = false;

      // 2. Filtro de texto insensible a tildes
      let matchTexto = true;
      if (normQuery) {
        matchTexto = searchBlob.includes(normQuery);
      }

      if (matchCategoria && matchTexto) {
        card.style.display = 'flex';
        visibles++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = `Mostrando ${visibles} de ${cards.length} planteles universitarios`;
    }

    if (visibles === 0) {
      grid.style.display = 'none';
      if (emptyState) emptyState.style.display = 'block';
    } else {
      grid.style.display = 'grid';
      if (emptyState) emptyState.style.display = 'none';
    }
  }

  // Delegación para botones de aporte directo
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target && target.closest && target.closest('.btn-aporte-directo')) {
      const btn = target.closest('.btn-aporte-directo');
      const uNom = decodeURIComponent(btn.getAttribute('data-universidad') || '');
      if (window.abrirModalAporte && uNom) {
        window.abrirModalAporte(uNom);
      }
    }
  });

  // Event Listeners para Filtros
  document.querySelectorAll('.matriz-btn-f').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.matriz-btn-f').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      filtroActual = btn.getAttribute('data-filter') || 'todas';
      filtrarMatriz();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    busquedaActual = e.target.value;
    filtrarMatriz();
  });

  resetBtn?.addEventListener('click', () => {
    filtroActual = 'todas';
    busquedaActual = '';
    if (searchInput) searchInput.value = '';
    document.querySelectorAll('.matriz-btn-f').forEach(b => {
      if (b.getAttribute('data-filter') === 'todas') {
        b.classList.remove('btn-outline');
        b.classList.add('btn-primary');
      } else {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      }
    });
    filtrarMatriz();
  });
</script>
