---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import matrizData from '../../data/matriz_54_universidades.json';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const totalOficiales = matrizData.length; // 54
const conInstrumento = matrizData.filter(u => !u.en_brecha).length; // 32
const sinInstrumento = matrizData.filter(u => u.en_brecha).length; // 22
const porcentajeCobertura = ((conInstrumento / totalOficiales) * 100).toFixed(1); // 59.3%
const conCompras = matrizData.filter(u => u.dimensiones.compras_ia).length; // 10

// Subtotales cruzados exactos por segmento institucional
const estatales = matrizData.filter(u => u.tipo_categoria === 'Estatales');
const estatalesCon = estatales.filter(u => !u.en_brecha).length; // 8
const estatalesSin = estatales.filter(u => u.en_brecha).length; // 10

const cruch = matrizData.filter(u => u.tipo_categoria === 'Privadas CRUCH');
const cruchCon = cruch.filter(u => !u.en_brecha).length; // 7
const cruchSin = cruch.filter(u => u.en_brecha).length; // 2

const noCruch = matrizData.filter(u => u.tipo_categoria === 'Privadas no CRUCH');
const noCruchCon = noCruch.filter(u => !u.en_brecha).length; // 17
const noCruchSin = noCruch.filter(u => u.en_brecha).length; // 10

// Subtotales Territoriales y de Alcance Normativo
const uesRegionales = matrizData.filter(u => u.territorio === 'Regional'); // 25
const uesMetro = matrizData.filter(u => u.territorio !== 'Regional'); // 29
const uesCentral = matrizData.filter(u => u.alcance_normativo?.includes('Institucional')); // 27
const uesFacultad = matrizData.filter(u => u.alcance_normativo === 'Por Facultad'); // 5

function normalizeForSearch(str: string): string {
  return (str || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}
---

<section id="matriz-nacional" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.4rem;">
        <span class="badge badge-green">{t('matriz.badge_official')}</span>
        <span class="badge badge-blue">{t('matriz.badge_sies')}</span>
      </div>
      <h2>{t('matriz.title')}</h2>
      <p style="color:var(--text-muted); max-width:850px; font-size:0.96rem; line-height:1.55;">
        {t('matriz.desc')}
      </p>
    </div>

    <!-- Indicador de Cobertura General -->
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:1rem 1.5rem; border-radius:12px; text-align:right; box-shadow:var(--shadow-sm);">
      <div style="font-size:2rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif); line-height:1;">
        {porcentajeCobertura}%
      </div>
      <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.25rem;">
        {conInstrumento} {lang === 'en' ? 'with policy' : lang === 'pt' ? 'com diretriz' : 'con instrumento'} / {sinInstrumento} {lang === 'en' ? 'without identified public policy' : lang === 'pt' ? 'sem diretriz pública identificada' : 'sin instrumento público'}
      </div>
    </div>
  </div>

  <!-- Tarjetas KPI del Catastro Oficial -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap:1rem; margin-bottom:2rem;">
    <div class="card" style="padding:1.2rem; text-align:center;">
      <div style="font-size:1.8rem; font-weight:700; color:var(--text-main); font-family:var(--font-serif);">{totalOficiales}</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">{t('matriz.kpi_official_ues')}</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--accent-green);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-green); font-family:var(--font-serif);">{conInstrumento} (59.3%)</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">{t('matriz.kpi_with_doc')}</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--text-muted);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--text-main); font-family:var(--font-serif);">{sinInstrumento} (40.7%)</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">{t('matriz.kpi_without_doc')}</div>
    </div>
    <div class="card" style="padding:1.2rem; text-align:center; border-left:3px solid var(--accent-blue);">
      <div style="font-size:1.8rem; font-weight:700; color:var(--accent-blue); font-family:var(--font-serif);">{conCompras} {lang === 'en' ? 'Universities' : lang === 'pt' ? 'Instituições' : 'Planteles'}</div>
      <div style="font-size:0.8rem; color:var(--text-muted);">{t('matriz.kpi_procurement')}</div>
    </div>
  </div>

  <!-- Barra de Aporte Colaborativo de Normativas -->
  <div style="background: linear-gradient(to right, rgba(14, 116, 144, 0.08), rgba(16, 185, 129, 0.08)); border: 1px solid var(--border-color); border-left: 4px solid var(--accent-blue); border-radius: 8px; padding: 0.9rem 1.25rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <strong style="font-size: 0.88rem; color: var(--text-main);">{t('matriz.banner_title')}</strong>
      <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem;">
        {t('matriz.banner_desc')}
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <button 
        type="button" 
        class="btn btn-primary btn-sm"
        onclick="window.abrirModalAporte && window.abrirModalAporte('')"
        style="font-size: 0.8rem; padding: 0.4rem 0.8rem;"
      >
        {t('matriz.card_btn_submit')}
      </button>
    </div>
  </div>

  <!-- Barra de Filtros Separados y Búsqueda -->
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; padding:1.25rem; margin-bottom:1.5rem; box-shadow:var(--shadow-sm);">
    
    <!-- Filtro 1: Tipo Institucional -->
    <div style="margin-bottom:1rem;">
      <div style="font-size:0.76rem; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.45rem; letter-spacing:0.5px;">
        {t('matriz.filter_type_label')}
      </div>
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="filter-tipo-buttons">
        <button type="button" class="btn btn-primary btn-sm btn-f-tipo" data-tipo="todas">
          {t('matriz.filter_type_all')} ({totalOficiales})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-tipo" data-tipo="Estatales">
          {t('matriz.filter_type_state')} ({estatales.length})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-tipo" data-tipo="Privadas CRUCH">
          {t('matriz.filter_type_cruch')} ({cruch.length})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-tipo" data-tipo="Privadas no CRUCH">
          {t('matriz.filter_type_nocruch')} ({noCruch.length})
        </button>
      </div>
    </div>

    <!-- Filtro 2: Estado de Identificación Documental -->
    <div style="margin-bottom:1rem; border-top:1px solid var(--border-color); padding-top:0.85rem;">
      <div style="font-size:0.76rem; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.45rem; letter-spacing:0.5px;">
        {t('matriz.filter_status_label')}
      </div>
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="filter-estado-buttons">
        <button type="button" class="btn btn-primary btn-sm btn-f-estado" data-estado="todos">
          {t('matriz.filter_status_all')} ({totalOficiales})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-estado" data-estado="con-instrumento" style="color:var(--accent-green);">
          {t('matriz.filter_status_with')} ({conInstrumento})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-estado" data-estado="sin-instrumento" style="color:var(--text-muted);">
          {t('matriz.filter_status_without')} ({sinInstrumento})
        </button>
      </div>
    </div>

    <!-- Filtro 3: Presencia Territorial (Descentralización Regional) -->
    <div style="margin-bottom:1rem; border-top:1px solid var(--border-color); padding-top:0.85rem;">
      <div style="font-size:0.76rem; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.45rem; letter-spacing:0.5px;">
        {t('matriz.filter_geo_label')}
      </div>
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="filter-territorio-buttons">
        <button type="button" class="btn btn-primary btn-sm btn-f-territorio" data-territorio="todos">
          {t('matriz.filter_geo_all')} ({totalOficiales})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-territorio" data-territorio="Regional">
          {t('matriz.filter_geo_regional')} ({uesRegionales.length})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-territorio" data-territorio="Metropolitana / Nacional">
          {t('matriz.filter_geo_metro')} ({uesMetro.length})
        </button>
      </div>
    </div>

    <!-- Filtro 4: Nivel del Instrumento Normativo -->
    <div style="margin-bottom:1.15rem; border-top:1px solid var(--border-color); padding-top:0.85rem;">
      <div style="font-size:0.76rem; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.45rem; letter-spacing:0.5px;">
        {t('matriz.filter_scope_label')}
      </div>
      <div style="display:flex; gap:0.4rem; flex-wrap:wrap;" id="filter-alcance-buttons">
        <button type="button" class="btn btn-primary btn-sm btn-f-alcance" data-alcance="todos">
          {t('matriz.filter_scope_all')} ({totalOficiales})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-alcance" data-alcance="institucional" style="color:var(--accent-blue);">
          {t('matriz.filter_scope_central')} ({uesCentral.length})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-alcance" data-alcance="facultad" style="color:var(--accent-amber);">
          {t('matriz.filter_scope_faculty')} ({uesFacultad.length})
        </button>
        <button type="button" class="btn btn-outline btn-sm btn-f-alcance" data-alcance="sin-instrumento" style="color:var(--text-muted);">
          {t('matriz.filter_scope_none')} ({sinInstrumento})
        </button>
      </div>
    </div>

    <!-- Buscador en Tiempo Real y Contador -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.85rem; border-top:1px solid var(--border-color); padding-top:0.85rem;">
      <div style="min-width:260px; flex:1; max-width:420px;">
        <input 
          type="text" 
          id="matriz-search-input" 
          placeholder={t('matriz.search_placeholder')}
          style="width:100%; padding:0.45rem 0.8rem; border:1px solid var(--border-color); border-radius:6px; background:var(--canvas-bg); color:var(--text-main); font-size:0.84rem;"
        />
      </div>

      <div style="font-size:0.82rem; color:var(--text-muted);">
        <span id="matriz-count-display">
          {lang === 'en' 
            ? `Showing 54 of 54 universities` 
            : lang === 'pt' 
            ? `Exibindo 54 de 54 universidades` 
            : `Mostrando 54 de 54 planteles universitarios`}
        </span>
      </div>
    </div>

  </div>

  <!-- Leyenda de las 6 Dimensiones del Catastro -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:0.5rem; margin-bottom:0.75rem; font-size:0.78rem; background:rgba(0,0,0,0.02); padding:0.75rem 1rem; border-radius:8px; border:1px solid var(--border-color);">
    <div><strong>{t('matriz.legend_aula')}</strong></div>
    <div><strong>{t('matriz.legend_tesis')}</strong></div>
    <div><strong>{t('matriz.legend_autoria')}</strong></div>
    <div><strong>{t('matriz.legend_privacidad')}</strong></div>
    <div><strong>{t('matriz.legend_eval')}</strong></div>
    <div><strong>{t('matriz.legend_compras')}*</strong></div>
  </div>
  <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:1.5rem; padding:0 0.25rem; line-height:1.4;">
    <em>* <strong>Régimen de Compras:</strong> Aplica por ley exclusivamente a las 18 Universidades Estatales (Ley N° 19.886 / Mercado Público). En universidades privadas figura como <code>N/A*</code> para descartar cualquier sesgo comparativo.</em>
  </div>

  <!-- Grilla de Tarjetas de la Matriz (Prerenderizada por SSR) -->
  <div id="matriz-cards-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap:1.25rem;">
    {matrizData.map((u) => {
      const dims = u.dimensiones;
      const searchBlob = `${normalizeForSearch(u.nombre)} ${normalizeForSearch(u.sigla)} ${normalizeForSearch(u.tipo_oficial)} ${normalizeForSearch(u.tipo_categoria)} ${normalizeForSearch(u.sede_central || '')} ${normalizeForSearch(u.territorio || '')} ${normalizeForSearch(u.alcance_normativo || '')}`;
      const tieneDoc = !u.en_brecha;
      const esRegional = u.territorio === 'Regional';
      const esCentral = u.alcance_normativo?.includes('Institucional');
      
      return (
        <div 
          class="card matriz-card"
          data-tipo-categoria={u.tipo_categoria}
          data-tiene-doc={tieneDoc ? 'true' : 'false'}
          data-territorio={u.territorio || 'Metropolitana / Nacional'}
          data-alcance={tieneDoc ? (esCentral ? 'institucional' : 'facultad') : 'sin-instrumento'}
          data-search={searchBlob}
          style={`display:flex; flex-direction:column; justify-content:space-between; border-top: 3px solid ${tieneDoc ? 'var(--accent-green)' : 'var(--border-color)'};`}
        >
          <div>
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem; gap:0.5rem; flex-wrap:wrap;">
              <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
                <span class={`badge ${tieneDoc ? 'badge-green' : 'badge-outline'}`} style={!tieneDoc ? 'border:1px solid var(--border-color); color:var(--text-muted); font-size:0.7rem;' : 'font-size:0.7rem;'}>
                  {tieneDoc ? t('matriz.card_with_doc') : t('matriz.card_without_doc')}
                </span>
                <span class="badge" style={`font-size:0.68rem; padding:0.15rem 0.4rem; background:rgba(0,0,0,0.04); color:var(--text-main); border:1px solid var(--border-color);`}>
                  {esRegional ? `📍 ${u.sede_central}` : '🏛️ Santiago'}
                </span>
                {tieneDoc && (
                  <span class={`badge ${esCentral ? 'badge-blue' : 'badge-outline'}`} style={!esCentral ? 'font-size:0.68rem; padding:0.15rem 0.4rem; color:var(--accent-amber); border-color:var(--accent-amber);' : 'font-size:0.68rem; padding:0.15rem 0.4rem;'}>
                    {esCentral ? t('matriz.card_central') : t('matriz.card_faculty')}
                  </span>
                )}
              </div>
              <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">{u.registro}</span>
            </div>

            <h3 style="font-size:1.05rem; line-height:1.3; margin-bottom:0.35rem;">
              {u.nombre}
            </h3>

            <div style="display:flex; gap:0.5rem; align-items:center; font-size:0.78rem; color:var(--text-muted); margin-bottom:1rem; flex-wrap:wrap;">
              <span style="font-weight:600; color:var(--text-main);">
                {u.tipo_categoria === 'Estatales' 
                  ? (lang === 'en' ? 'State University' : lang === 'pt' ? 'Universidade Estatal' : 'Estatal')
                  : u.tipo_categoria === 'Privadas CRUCH'
                  ? (lang === 'en' ? 'CRUCH Private' : lang === 'pt' ? 'Privada CRUCH' : 'Privada CRUCH')
                  : (lang === 'en' ? 'Non-CRUCH Private' : lang === 'pt' ? 'Privada não CRUCH' : 'Privada no CRUCH')}
              </span>
              <span>•</span>
              <span>{u.total_instrumentos} {t('matriz.card_docs_count')}</span>
            </div>

            <!-- Semáforo de las 6 dimensiones objetivas (adaptable a pantallas móviles) -->
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(85px, 1fr)); gap:0.4rem; background:rgba(0,0,0,0.02); padding:0.6rem 0.75rem; border-radius:6px; font-size:0.76rem; margin-bottom:1.1rem; border:1px solid var(--border-color);">
              <div>
                {dims.protocolo_aula ? (
                  <span title={lang === 'en' ? 'Classroom Policy Identified' : lang === 'pt' ? 'Diretriz de Ensino Identificada' : 'Protocolo de Aula Identificado'} style="color:var(--accent-green); font-weight:600;">✓ {lang === 'en' ? 'Classroom' : lang === 'pt' ? 'Aula' : 'Aula'}</span>
                ) : (
                  <span title={lang === 'en' ? 'Not explicit in public AI policy' : lang === 'pt' ? 'Não explicitado em política pública de IA' : 'No explicitado en norma IA pública'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Classroom' : lang === 'pt' ? 'Aula' : 'Aula'}</span>
                )}
              </div>
              <div>
                {dims.directriz_tesis ? (
                  <span title={lang === 'en' ? 'Thesis Policy Identified' : lang === 'pt' ? 'Diretriz de Teses Identificada' : 'Directriz de Tesis Identificada'} style="color:var(--accent-green); font-weight:600;">✓ {lang === 'en' ? 'Thesis' : lang === 'pt' ? 'Teses' : 'Tesis'}</span>
                ) : (
                  <span title={lang === 'en' ? 'Not explicit in public AI policy' : lang === 'pt' ? 'Não explicitado em política pública de IA' : 'No explicitado en norma IA pública'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Thesis' : lang === 'pt' ? 'Teses' : 'Tesis'}</span>
                )}
              </div>
              <div>
                {dims.regla_autoria ? (
                  <span title={lang === 'en' ? 'Authorship Rule Identified' : lang === 'pt' ? 'Regra de Autoria Identificada' : 'Regla de Autoría Identificada'} style="color:var(--accent-green); font-weight:600;">✓ {lang === 'en' ? 'Authorship' : lang === 'pt' ? 'Autoria' : 'Autoría'}</span>
                ) : (
                  <span title={lang === 'en' ? 'Not explicit in public AI policy' : lang === 'pt' ? 'Não explicitado em política pública de IA' : 'No explicitado en norma IA pública'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Authorship' : lang === 'pt' ? 'Autoria' : 'Autoría'}</span>
                )}
              </div>
              <div>
                {dims.privacidad_ley_21719 ? (
                  <span title={lang === 'en' ? 'Privacy Clause Identified' : lang === 'pt' ? 'Cláusula de Privacidade Identificada' : 'Previsión de Privacidad Identificada'} style="color:var(--accent-blue); font-weight:600;">✓ {lang === 'en' ? 'Privacy' : lang === 'pt' ? 'Privacidade' : 'Privacidad'}</span>
                ) : (
                  <span title={lang === 'en' ? 'Not explicit in public AI policy' : lang === 'pt' ? 'Não explicitado em política pública de IA' : 'No explicitado en norma IA pública'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Privacy' : lang === 'pt' ? 'Privacidade' : 'Privacidad'}</span>
                )}
              </div>
              <div>
                {dims.modifica_evaluacion ? (
                  <span title={lang === 'en' ? 'Assessment Redesign Identified' : lang === 'pt' ? 'Redesenho Avaliativo Identificado' : 'Rediseño Evaluativo Identificado'} style="color:var(--accent-green); font-weight:600;">✓ {lang === 'en' ? 'Grading' : lang === 'pt' ? 'Avaliação' : 'Evaluación'}</span>
                ) : (
                  <span title={lang === 'en' ? 'Not explicit in public AI policy' : lang === 'pt' ? 'Não explicitado em política pública de IA' : 'No explicitado en norma IA pública'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Grading' : lang === 'pt' ? 'Avaliação' : 'Evaluación'}</span>
                )}
              </div>
              <div>
                {u.tipo_categoria === 'Estatales' ? (
                  dims.compras_ia ? (
                    <span title={lang === 'en' ? 'AI Procurement Registered (Ley 19.886)' : lang === 'pt' ? 'Licitações de IA Registradas (Lei 19.886)' : 'Compras IA Registradas en ChileCompra (Ley 19.886)'} style="color:var(--accent-amber); font-weight:600;">💰 {lang === 'en' ? 'Procurement' : lang === 'pt' ? 'Compras' : 'Compras'} ({u.compras?.total || 1})</span>
                  ) : (
                    <span title={lang === 'en' ? 'No AI Procurement Registered in Mercado Público' : lang === 'pt' ? 'Sem Compras de IA Registradas no Mercado Público' : 'Sin Compras de IA Registradas en Mercado Público'} style="color:var(--text-muted);">○ {lang === 'en' ? 'Procurement' : lang === 'pt' ? 'Compras' : 'Compras'}</span>
                  )
                ) : (
                  <span title={lang === 'en' ? 'N/A: Private university not subject to Public Procurement Law (Ley 19.886)' : lang === 'pt' ? 'N/A: Universidade privada não sujeita à Lei de Compras Públicas' : 'N/A: Régimen privado no afecto a Ley N° 19.886 de Compras Públicas'} style="color:var(--text-muted); font-size:0.74rem;">
                    <span style="background:rgba(0,0,0,0.04); padding:0.1rem 0.35rem; border-radius:4px; border:1px solid var(--border-color);">N/A* Privada</span>
                  </span>
                )}
              </div>
            </div>

            <!-- Listado de instrumentos vinculados -->
            {u.instrumentos && u.instrumentos.length > 0 ? (
              <div style="font-size:0.78rem; margin-bottom:1rem;">
                <div style="font-weight:600; color:var(--text-main); margin-bottom:0.35rem;">
                  {lang === 'en' ? 'Identified instruments:' : lang === 'pt' ? 'Instrumentos identificados:' : 'Instrumentos identificados:'}
                </div>
                <ul style="list-style:none; padding-left:0; margin:0; display:flex; flex-direction:column; gap:0.4rem;">
                  {u.instrumentos.map((doc: any) => (
                    <li style="border-left:2px solid var(--accent-blue); padding-left:0.5rem; line-height:1.35;">
                      <a href={doc.url} target="_blank" rel="noopener noreferrer" style="color:var(--accent-blue); text-decoration:none; font-weight:500;">
                        {doc.documento} &rarr;
                      </a>
                      <div style="font-size:0.72rem; color:var(--text-muted);">{doc.unidad} ({doc.fecha || 'N/D'})</div>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div style="background:rgba(0,0,0,0.02); padding:0.75rem; border-radius:6px; font-size:0.78rem; color:var(--text-muted); margin-bottom:1rem; border:1px dashed var(--border-color); line-height:1.4;">
                {t('matriz.card_no_doc_desc')}
              </div>
            )}
          </div>

          <!-- Pie de tarjeta con acción comunitaria -->
          <div style="border-top:1px solid var(--border-color); padding-top:0.75rem; display:flex; justify-content:space-between; align-items:center; font-size:0.76rem; flex-wrap:wrap; gap:0.4rem;">
            {tieneDoc ? (
              <div style="display:flex; gap:0.45rem; align-items:center; flex-wrap:wrap;">
                <span style="color:var(--accent-green); font-weight:600;">{t('matriz.card_cataloged')}</span>
                <button 
                  type="button" 
                  class="btn-aporte-directo"
                  data-universidad={encodeURIComponent(u.nombre)}
                  style="background:none; border:none; padding:0; color:var(--text-muted); text-decoration:underline; cursor:pointer; font-size:0.72rem;"
                  title="¿Conoces un nuevo decreto o actualización? Aportar antecedente"
                >
                  {t('matriz.card_btn_update')}
                </button>
              </div>
            ) : (
              <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap;">
                <button 
                  type="button" 
                  class="btn btn-outline btn-sm btn-aporte-directo"
                  data-universidad={encodeURIComponent(u.nombre)}
                  style="font-size:0.74rem; padding:0.25rem 0.65rem; color:var(--accent-blue); border-color:var(--accent-blue);"
                >
                  {t('matriz.card_btn_submit')}
                </button>
              </div>
            )}
            <span style="color:var(--text-muted); font-size:0.72rem;">Sigla: {u.sigla}</span>
          </div>

        </div>
      );
    })}
  </div>

  <!-- Estado Vacío -->
  <div id="matriz-empty-state" style="display:none; text-align:center; padding:3rem 1.5rem; background:var(--card-bg); border:1px solid var(--border-color); border-radius:12px; margin-top:1.5rem;">
    <div style="font-size:2rem; margin-bottom:0.5rem;">🔍</div>
    <div style="font-weight:600; margin-bottom:0.25rem;">No se encontraron planteles con los filtros seleccionados</div>
    <div style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">Intenta seleccionar otro segmento institucional o limpiar la búsqueda.</div>
    <button type="button" id="matriz-reset-btn" class="btn btn-primary btn-sm">Restablecer Todos los Filtros</button>
  </div>

</section>

<script is:inline>
  let filtroTipoActual = 'todas';
  let filtroEstadoActual = 'todos';
  let filtroTerritorioActual = 'todos';
  let filtroAlcanceActual = 'todos';
  let busquedaActual = '';

  const cards = document.querySelectorAll('.matriz-card');
  const countDisplay = document.getElementById('matriz-count-display');
  const searchInput = document.getElementById('matriz-search-input');
  const resetBtn = document.getElementById('matriz-reset-btn');
  const grid = document.getElementById('matriz-cards-grid');
  const emptyState = document.getElementById('matriz-empty-state');

  function normalizeInput(str) {
    return (str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function filtrarMatriz() {
    if (!grid || cards.length === 0) return;

    const normQuery = normalizeInput(busquedaActual);
    let visibles = 0;

    cards.forEach(card => {
      const tipo = card.getAttribute('data-tipo-categoria');
      const tieneDoc = card.getAttribute('data-tiene-doc') === 'true';
      const territorio = card.getAttribute('data-territorio') || '';
      const alcance = card.getAttribute('data-alcance') || '';
      const searchBlob = card.getAttribute('data-search') || '';

      // 1. Filtro Ortogonal por Tipo Institucional
      let matchTipo = true;
      if (filtroTipoActual !== 'todas' && tipo !== filtroTipoActual) {
        matchTipo = false;
      }

      // 2. Filtro Ortogonal por Estado Documental
      let matchEstado = true;
      if (filtroEstadoActual === 'con-instrumento' && !tieneDoc) {
        matchEstado = false;
      }
      if (filtroEstadoActual === 'sin-instrumento' && tieneDoc) {
        matchEstado = false;
      }

      // 3. Filtro por Presencia Territorial (Regional vs Metro)
      let matchTerritorio = true;
      if (filtroTerritorioActual !== 'todos' && territorio !== filtroTerritorioActual) {
        matchTerritorio = false;
      }

      // 4. Filtro por Nivel del Instrumento
      let matchAlcance = true;
      if (filtroAlcanceActual !== 'todos' && alcance !== filtroAlcanceActual) {
        matchAlcance = false;
      }

      // 5. Filtro de Texto (Insensible a tildes y mayúsculas)
      let matchTexto = true;
      if (normQuery) {
        matchTexto = searchBlob.includes(normQuery);
      }

      if (matchTipo && matchEstado && matchTerritorio && matchAlcance && matchTexto) {
        card.style.display = 'flex';
        visibles++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countDisplay) {
      const pageLang = document.documentElement.lang || 'es';
      if (pageLang === 'en') {
        countDisplay.textContent = `Showing ${visibles} of ${cards.length} universities`;
      } else if (pageLang === 'pt') {
        countDisplay.textContent = `Exibindo ${visibles} de ${cards.length} universidades`;
      } else {
        countDisplay.textContent = `Mostrando ${visibles} de ${cards.length} planteles universitarios`;
      }
    }

    if (visibles === 0) {
      grid.style.display = 'none';
      if (emptyState) emptyState.style.display = 'block';
    } else {
      grid.style.display = 'grid';
      if (emptyState) emptyState.style.display = 'none';
    }
  }

  // Delegación para botones de aporte directo
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target && target.closest && target.closest('.btn-aporte-directo')) {
      const btn = target.closest('.btn-aporte-directo');
      const uNom = decodeURIComponent(btn.getAttribute('data-universidad') || '');
      if (window.abrirModalAporte && uNom) {
        window.abrirModalAporte(uNom);
      }
    }
  });

  // Manejo de botones de Filtro por Tipo
  document.querySelectorAll('.btn-f-tipo').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-f-tipo').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      filtroTipoActual = btn.getAttribute('data-tipo') || 'todas';
      filtrarMatriz();
    });
  });

  // Manejo de botones de Filtro por Estado
  document.querySelectorAll('.btn-f-estado').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-f-estado').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      filtroEstadoActual = btn.getAttribute('data-estado') || 'todos';
      filtrarMatriz();
    });
  });

  // Manejo de botones de Filtro por Territorio
  document.querySelectorAll('.btn-f-territorio').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-f-territorio').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      filtroTerritorioActual = btn.getAttribute('data-territorio') || 'todos';
      filtrarMatriz();
    });
  });

  // Manejo de botones de Filtro por Alcance Normativo
  document.querySelectorAll('.btn-f-alcance').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-f-alcance').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-outline');
      });
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
      filtroAlcanceActual = btn.getAttribute('data-alcance') || 'todos';
      filtrarMatriz();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    busquedaActual = e.target.value;
    filtrarMatriz();
  });

  resetBtn?.addEventListener('click', () => {
    filtroTipoActual = 'todas';
    filtroEstadoActual = 'todos';
    filtroTerritorioActual = 'todos';
    filtroAlcanceActual = 'todos';
    busquedaActual = '';
    if (searchInput) searchInput.value = '';

    document.querySelectorAll('.btn-f-tipo').forEach(b => {
      b.classList.toggle('btn-primary', b.getAttribute('data-tipo') === 'todas');
      b.classList.toggle('btn-outline', b.getAttribute('data-tipo') !== 'todas');
    });

    document.querySelectorAll('.btn-f-estado').forEach(b => {
      b.classList.toggle('btn-primary', b.getAttribute('data-estado') === 'todos');
      b.classList.toggle('btn-outline', b.getAttribute('data-estado') !== 'todos');
    });

    document.querySelectorAll('.btn-f-territorio').forEach(b => {
      b.classList.toggle('btn-primary', b.getAttribute('data-territorio') === 'todos');
      b.classList.toggle('btn-outline', b.getAttribute('data-territorio') !== 'todos');
    });

    document.querySelectorAll('.btn-f-alcance').forEach(b => {
      b.classList.toggle('btn-primary', b.getAttribute('data-alcance') === 'todos');
      b.classList.toggle('btn-outline', b.getAttribute('data-alcance') !== 'todos');
    });

    filtrarMatriz();
  });
</script>
