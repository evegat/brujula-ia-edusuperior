---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="guia-uso" style="margin-bottom: 2.75rem; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem 1.75rem; box-shadow: var(--shadow-sm);">
  
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
    <div>
      <div style="font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.6px; margin-bottom: 0.25rem;">
        {lang === 'en' ? 'Quick Orientation' : lang === 'pt' ? 'Orientação Rápida' : 'Orientación Rápida'}
      </div>
      <h2 style="font-size: 1.35rem; margin: 0; font-family: var(--font-serif); color: var(--text-main);">
        {lang === 'en' 
          ? 'How to explore and use this Observatory'
          : lang === 'pt'
          ? 'Como explorar e utilizar este Observatório'
          : 'Cómo explorar y utilizar este Observatorio'}
      </h2>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0.35rem 0 0 0; line-height: 1.45; max-width: 780px;">
        {lang === 'en'
          ? 'Open platform designed for higher education leaders, faculty, researchers, and students. Follow these 3 steps:'
          : lang === 'pt'
          ? 'Plataforma aberta projetada para gestores universitários, docentes, pesquisadores e estudantes. Siga estes 3 passos:'
          : 'Plataforma abierta diseñada para directivos universitarios, docentes, investigadores y estudiantes. Sigue estos 3 pasos para orientar tu consulta:'}
      </p>
    </div>

    <!-- Botones de Acción Directa para Colaboración -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <button 
        type="button" 
        class="btn btn-primary btn-sm"
        onclick="window.abrirModalAporte && window.abrirModalAporte('')"
        style="font-size: 0.82rem; padding: 0.45rem 0.85rem; display: inline-flex; align-items: center; gap: 0.4rem;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        {lang === 'en' ? 'Submit Policy or Decree' : lang === 'pt' ? 'Enviar Diretriz ou Decreto' : 'Aportar Normativa o Decreto'}
      </button>
    </div>
  </div>

  <!-- 3 Pasos de Uso Clave -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
    
    <!-- Paso 1 -->
    <div style="background: rgba(0, 0, 0, 0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem 1.15rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
        <span style="background: var(--accent-blue); color: #ffffff; font-weight: 700; font-size: 0.72rem; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">1</span>
        <strong style="font-size: 0.92rem; color: var(--text-main);">
          {lang === 'en' ? 'Find Your University' : lang === 'pt' ? 'Encontre sua Universidade' : 'Encuentra tu Universidad'}
        </strong>
      </div>
      <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.45; margin: 0;">
        {lang === 'en'
          ? 'Filter the 54-University Matrix by type (State, CRUCH, Private) or search by name. Check identified rules in classroom use, thesis work, and grading.'
          : lang === 'pt'
          ? 'Filtre na Matriz de 54 Universidades por tipo (Estatais, CRUCH, Privadas) ou busque por nome. Verifique diretrizes em sala de aula, teses e avaliação.'
          : 'Filtra en la Matriz Nacional por tipo (Estatales, CRUCH, Privadas) o busca por nombre/sigla. Revisa si tu plantel cuenta con directrices identificadas en aula, tesis, autoría o rediseño evaluativo.'}
      </p>
    </div>

    <!-- Paso 2 -->
    <div style="background: rgba(0, 0, 0, 0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem 1.15rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
        <span style="background: var(--accent-blue); color: #ffffff; font-weight: 700; font-size: 0.72rem; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">2</span>
        <strong style="font-size: 0.92rem; color: var(--text-main);">
          {lang === 'en' ? 'Audit Procurement & Privacy' : lang === 'pt' ? 'Audite Compras e Privacidade' : 'Audita Compras y Privacidad'}
        </strong>
      </div>
      <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.45; margin: 0;">
        {lang === 'en'
          ? 'Examine 81 public tech procurement tenders and assess compliance with Data Privacy Law No. 21,719 and ethical AI standards.'
          : lang === 'pt'
          ? 'Consulte 81 licitações em compras públicas e avalie a conformidade com a Lei Nº 21.719 de Proteção de Dados e governança de IA.'
          : 'Consulta las 81 transacciones en Mercado Público (universidades estatales) y evalúa el cumplimiento frente a la nueva Ley N° 21.719 de Protección de Datos Personales con nuestro kit de adopción.'}
      </p>
    </div>

    <!-- Paso 3 -->
    <div style="background: rgba(0, 0, 0, 0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem 1.15rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
        <span style="background: var(--accent-green); color: #ffffff; font-weight: 700; font-size: 0.72rem; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">3</span>
        <strong style="font-size: 0.92rem; color: var(--text-main);">
          {lang === 'en' ? 'Submit Policies or Download' : lang === 'pt' ? 'Envie Políticas ou Baixe Dados' : 'Aporta Normativas o Descarga'}
        </strong>
      </div>
      <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.45; margin: 0;">
        {lang === 'en'
          ? 'If your university policy is missing or newly enacted, submit the link or email the PDF. Download open datasets in JSON and CSV freely.'
          : lang === 'pt'
          ? 'Se a política da sua instituição estiver ausente ou desatualizada, envie o link ou PDF. Baixe datasets abertos em JSON e CSV sem barreiras.'
          : 'Si falta la política de tu universidad o salió un decreto nuevo, aporta el link o mándanos el PDF. También puedes descargar la planilla y datasets abiertos en JSON/CSV sin barreras.'}
      </p>
    </div>

  </div>

</section>
