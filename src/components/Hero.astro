---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import matrizData from '../../data/matriz_54_universidades.json';
import inventarioData from '../../inventario.json';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const totalUes = matrizData.length; // 54
const conInst = matrizData.filter(u => !u.en_brecha).length; // 32
const enBrecha = matrizData.filter(u => u.en_brecha).length; // 22
const totalDocs = inventarioData.length; // 52
const docsUes = inventarioData.filter(d => !d.tipo_institucion?.includes('IP') && !d.tipo_institucion?.includes('CFT')).length; // 46
const docsIP = totalDocs - docsUes; // 6
---

<section id="inicio" style="margin-bottom: 2.75rem; scroll-margin-top: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 2.25rem;">
  
  <!-- Encabezado Editorial Sobrio -->
  <div style="margin-bottom: 1.5rem;">
    <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.6rem; flex-wrap: wrap;">
      <span class="badge badge-blue">{t('hero.badge_unesco')}</span>
      <span class="badge badge-green">{t('hero.badge_free')}</span>
    </div>

    <h1 style="font-size: clamp(1.85rem, 3.5vw, 2.65rem); line-height: 1.2; font-family: var(--font-serif); font-weight: 700; color: var(--text-main); margin-bottom: 0.85rem; max-width: 950px;">
      {lang === 'en' 
        ? 'AI Higher Education Compass: AI Regulations in Chilean Universities'
        : lang === 'pt'
        ? 'Bússola de IA no Ensino Superior: Diretrizes de IA nas Universidades Chilenas'
        : 'Brújula IA: Normativas de Inteligencia Artificial en Universidades Chilenas'}
    </h1>

    <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 860px; line-height: 1.55; margin-bottom: 0.85rem;">
      {t('brand.artifact')}
    </p>

    <div style="font-size: 0.85rem; color: var(--text-muted); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.85rem;">
      <div>
        Investigación y desarrollo por <a href="https://www.linkedin.com/in/evegat1989/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); font-weight: 600; text-decoration: none;">Eduardo Vega Toledo</a> (Universidad de Chile, <a href="mailto:evegat@uchile.cl" style="color: var(--accent-blue); text-decoration: underline;">evegat@uchile.cl</a> / <a href="mailto:eduardo@evegat.cl" style="color: var(--text-muted); text-decoration: underline;">eduardo@evegat.cl</a>) • CC BY 4.0
      </div>

      <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
        <a 
          href="https://github.com/evegat/brujula-ia-edusuperior" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-sm"
          style="background: #24292f; color: #ffffff; font-size: 0.78rem; padding: 0.35rem 0.7rem; display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;"
        >
          <svg style="width: 12px; height: 12px; fill: #e3b341;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          ⭐ GitHub
        </a>
        <a 
          href="/matriz_54_universidades.json" 
          data-download-gate="true"
          data-file-label="Matriz de 54 Universidades (.json)"
          class="btn btn-outline btn-sm"
          style="font-size: 0.78rem; padding: 0.35rem 0.65rem; text-decoration: none;"
        >
          📂 Datos (.json)
        </a>
        <a 
          href="/matriz_54_universidades.csv" 
          data-download-gate="true"
          data-file-label="Matriz de 54 Universidades (.csv)"
          class="btn btn-outline btn-sm"
          style="font-size: 0.78rem; padding: 0.35rem 0.65rem; text-decoration: none; color: var(--accent-green); border-color: var(--accent-green);"
          title="Registro y descarga directa para Excel / SECPLA / VRA"
        >
          📊 Matriz (.csv)
        </a>
        <a 
          href="/llms.txt" 
          target="_blank" 
          class="btn btn-outline btn-sm"
          style="font-size: 0.78rem; padding: 0.35rem 0.65rem; color: var(--accent-blue); border-color: var(--accent-blue); text-decoration: none;"
          title="Especificación abierta para Agentes y LLMs"
        >
          🤖 llms.txt
        </a>
      </div>
    </div>

    <!-- Nota Visible de Corte Temporal y Actualización -->
    <div style="background: rgba(29, 78, 216, 0.05); border: 1px solid rgba(29, 78, 216, 0.2); border-left: 4px solid var(--accent-blue); padding: 0.65rem 0.95rem; border-radius: 6px; font-size: 0.82rem; color: var(--text-main); line-height: 1.45;">
      <strong>📅 {lang === 'en' ? 'Census Date:' : lang === 'pt' ? 'Data do Levantamento:' : 'Fecha del levantamiento:'}</strong> {lang === 'en' ? 'Data verified as of' : lang === 'pt' ? 'Dados verificados até' : 'Información verificada a'} <strong>{lang === 'en' ? 'October 2026' : lang === 'pt' ? 'Outubro de 2026' : 'Octubre de 2026'}</strong>. {lang === 'en' ? 'If your university recently approved new guidelines or you wish to clarify any record, please' : lang === 'pt' ? 'Se a sua universidade aprovou novas diretrizes recentemente ou deseja retificar algum dado,' : 'Si tu universidad aprobó recientemente una nueva directriz que aún no figure en esta versión o deseas precisar algún antecedente,'} <a href="mailto:evegat@uchile.cl?subject=Actualizaci%C3%B3n%20Normativa%20IA%20-%20Br%C3%BAjula%20IA" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">{lang === 'en' ? 'contact us directly' : lang === 'pt' ? 'entre em contato conosco' : 'escríbenos directamente'}</a> {lang === 'en' ? 'to update its record.' : lang === 'pt' ? 'para atualizar a ficha.' : 'para actualizar su ficha.'}
    </div>
  </div>

  <!-- Fila de Contexto Conceptual Inmediato (Sobria, Sin Hype) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
    
    <!-- Dato 1: Radiografía de Universidades -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem; letter-spacing: 0.5px;">
        🏛️ {lang === 'en' ? 'National Overview (54 Universities)' : lang === 'pt' ? 'Panorama Nacional (54 Universidades)' : 'Radiografía Nacional (54 Universidades)'}
      </div>
      <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem;">
        <span style="font-size: 1.75rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-main); line-height: 1;">
          {conInst} {lang === 'en' ? 'of' : lang === 'pt' ? 'de' : 'de'} {totalUes}
        </span>
        <span style="font-size: 0.85rem; font-weight: 600; color: var(--accent-green);">
          ({lang === 'en' ? '59.3% with policy' : lang === 'pt' ? '59.3% com política' : '59.3% con norma'})
        </span>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
        {lang === 'en' 
          ? `32 universities with identified protocol or policy; `
          : lang === 'pt'
          ? `32 universidades com protocolo ou política identificado; `
          : `32 universidades con protocolo o política identificado; `}
        <strong>
          {lang === 'en' 
            ? `${enBrecha} institutions without identified public policy`
            : lang === 'pt'
            ? `${enBrecha} instituições sem instrumento público identificado`
            : `${enBrecha} planteles sin instrumento público identificado`}
        </strong>
        {lang === 'en' ? ' in the census.' : lang === 'pt' ? ' no levantamento.' : ' en el levantamiento.'}
      </div>
    </div>

    <!-- Dato 2: Documentos Analizados -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem; letter-spacing: 0.5px;">
        📄 {lang === 'en' ? 'Analyzed Policy Documents' : lang === 'pt' ? 'Documentos e Normativas Analisados' : 'Documentos & Reglamentos Analizados'}
      </div>
      <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem;">
        <span style="font-size: 1.75rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-main); line-height: 1;">
          {totalDocs}
        </span>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
          {lang === 'en' ? 'policies and decrees' : lang === 'pt' ? 'políticas e decretos' : 'políticas y decretos'}
        </span>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
        {lang === 'en'
          ? `${docsUes} regulations in universities (central or faculty-level) and ${docsIP} in professional institutes and technical centers.`
          : lang === 'pt'
          ? `${docsUes} regulamentos em universidades (centrais ou por faculdade) e ${docsIP} em institutos profissionais e CFTs.`
          : `${docsUes} reglamentos en universidades (centrales o por facultad) y ${docsIP} en institutos profesionales y CFTs.`}
      </div>
    </div>

    <!-- Dato 3: Compras Públicas (Exclusivo Ues Estatales) -->
    <div style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.15rem 1.25rem;">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem; letter-spacing: 0.5px;">
        💰 {lang === 'en' ? 'Public Procurement (State Universities Only)' : lang === 'pt' ? 'Compras Públicas (Exclusivo Universidades Estatais)' : 'Compras Públicas (Sólo Ues del Estado)'}
      </div>
      <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem;">
        <span style="font-size: 1.75rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-main); line-height: 1;">
          85
        </span>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
          {lang === 'en' ? 'public procurement contracts' : lang === 'pt' ? 'contratos em compras públicas' : 'contratos en Mercado Público'}
        </span>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
        {lang === 'en'
          ? <>Software and AI tenders across <strong>10 public universities</strong> (30% procure AI without prior classroom policy).</>
          : lang === 'pt'
          ? <>Licitações de software e IA em <strong>10 universidades públicas</strong> (30% adquirem IA sem contar com diretriz prévia de aula).</>
          : <>Licitaciones de software e IA en <strong>10 universidades públicas</strong> (el 30% adquiere IA sin contar con protocolo previo).</>}
      </div>
    </div>

  </div>



</section>
