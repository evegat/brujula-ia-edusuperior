---
// src/components/SuscripcionComunidad.astro
// Apoyo comunitario en GitHub, conexión en LinkedIn y suscripción consentida (Ley N° 21.719)
---

<section id="comunidad-alertas" style="margin-bottom: 3.5rem; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm); border-top: 4px solid var(--accent-blue);">
  
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 2rem; align-items: start;">
    
    <!-- Columna 1: Apoyo Abierto en GitHub y LinkedIn -->
    <div>
      <div style="display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.5rem;">
        <span class="badge badge-blue">Comunidad & Código Abierto</span>
        <span class="badge badge-green">100% Gratuito</span>
      </div>
      <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin: 0 0 0.5rem 0; color: var(--text-main);">
        Apoya este bien público digital
      </h3>
      <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 1.25rem 0;">
        La Brújula IA es un observatorio independiente sin fines de lucro. Puedes apoyar su continuidad dándonos una estrella en GitHub, compartiéndolo con tus colegas o conectando directamente con Eduardo.
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;">
        <!-- GitHub Star -->
        <a 
          href="https://github.com/evegat/brujula-ia-edusuperior" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-sm"
          style="background: #24292f; color: #ffffff; font-weight: 600; font-size: 0.82rem; padding: 0.45rem 0.85rem; display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;"
          title="Danos una estrella en GitHub"
        >
          <svg style="width: 14px; height: 14px; fill: #e3b341;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          ⭐ Dar Estrella en GitHub
        </a>

        <!-- GitHub Fork -->
        <a 
          href="https://github.com/evegat/brujula-ia-edusuperior/fork" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm"
          style="font-size: 0.82rem; padding: 0.45rem 0.8rem; display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;"
          title="Hacer Fork del repositorio"
        >
          <svg style="width: 14px; height: 14px; fill: currentColor;" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
          🍴 Fork
        </a>

        <!-- Seguir en LinkedIn -->
        <a 
          href="https://www.linkedin.com/in/evegat1989/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm"
          style="font-size: 0.82rem; padding: 0.45rem 0.8rem; color: #0a66c2; border-color: #0a66c2; display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;"
          title="Seguir a Eduardo Vega Toledo en LinkedIn"
        >
          <svg style="width: 14px; height: 14px; fill: currentColor;" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z"/></svg>
          Seguir en LinkedIn
        </a>
      </div>
    </div>

    <!-- Columna 2: Recibir Alertas y Novedades (Consentimiento Ley N° 21.719) -->
    <div style="background: var(--canvas-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem;">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--accent-blue); margin-bottom: 0.25rem; letter-spacing: 0.5px;">
        ✉️ Alertas del Observatorio
      </div>
      <h4 style="font-size: 1.05rem; margin: 0 0 0.35rem 0; color: var(--text-main);">
        Recibe novedades cuando se actualicen las normativas
      </h4>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.85rem 0; line-height: 1.4;">
        Te avisaremos cuando una universidad apruebe nuevas reglas de IA, se sumen compras públicas o agreguemos plantillas docentes.
      </p>

      <form id="form-alertas-comunidad" style="display: flex; flex-direction: column; gap: 0.65rem;">
        <div>
          <input 
            type="email" 
            id="input-alerta-email" 
            required 
            placeholder="tu.correo@universidad.cl" 
            style="width: 100%; padding: 0.55rem 0.75rem; font-size: 0.85rem; border: 1px solid var(--border-color); border-radius: 6px; background: var(--card-bg); color: var(--text-main); box-sizing: border-box;"
          />
        </div>

        <div>
          <input 
            type="text" 
            id="input-alerta-institucion" 
            placeholder="Universidad o Facultad (Opcional)" 
            style="width: 100%; padding: 0.55rem 0.75rem; font-size: 0.85rem; border: 1px solid var(--border-color); border-radius: 6px; background: var(--card-bg); color: var(--text-main); box-sizing: border-box;"
          />
        </div>

        <!-- Checkbox de Consentimiento Expreso Ley N° 21.719 -->
        <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.74rem; color: var(--text-muted); cursor: pointer; line-height: 1.35;">
          <input type="checkbox" id="check-consentimiento-ley21719" required style="margin-top: 0.15rem;" />
          <span>
            Acepto recibir alertas y notas de Eduardo Vega Toledo. Mis datos no serán cedidos a terceros ni utilizados para entrenar modelos de IA (Ley N° 21.719). Podré cancelar mi suscripción cuando quiera con un clic.
          </span>
        </label>

        <button 
          type="submit" 
          id="btn-enviar-alerta"
          class="btn btn-primary btn-sm"
          style="align-self: flex-start; margin-top: 0.25rem;"
        >
          Avisarme de Novedades
        </button>

        <div id="alerta-status" style="display: none; font-size: 0.8rem; margin-top: 0.35rem;"></div>
      </form>
    </div>

  </div>

</section>

<script is:inline>
  const alertaForm = document.getElementById('form-alertas-comunidad');
  const alertaEmail = document.getElementById('input-alerta-email');
  const alertaInst = document.getElementById('input-alerta-institucion');
  const alertaConsent = document.getElementById('check-consentimiento-ley21719');
  const alertaBtn = document.getElementById('btn-enviar-alerta');
  const alertaStatus = document.getElementById('alerta-status');

  alertaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!alertaEmail || !alertaConsent?.checked) return;

    if (alertaBtn) {
      alertaBtn.disabled = true;
      alertaBtn.textContent = 'Registrando...';
    }

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: alertaEmail.value.trim(),
          institucion: alertaInst?.value.trim() || 'No informada',
          consentimiento_ley_21719: true,
          origen: 'brujula-p154'
        })
      });

      const data = await res.json();
      if (data.success) {
        if (alertaStatus) {
          alertaStatus.style.display = 'block';
          alertaStatus.style.color = 'var(--accent-green)';
          alertaStatus.textContent = '✓ ¡Registro confirmado! Hemos enviado un correo de confirmación a tu casilla. Te notificaremos ante novedades.';
        }
        alertaForm.reset();
      } else {
        throw new Error(data.error || 'Error al registrar.');
      }
    } catch (err) {
      if (alertaStatus) {
        alertaStatus.style.display = 'block';
        alertaStatus.style.color = '#ef4444';
        alertaStatus.textContent = 'Error: ' + (err.message || 'Inténtalo de nuevo en unos momentos.');
      }
    } finally {
      if (alertaBtn) {
        alertaBtn.disabled = false;
        alertaBtn.textContent = 'Avisarme de Novedades';
      }
    }
  });
</script>
