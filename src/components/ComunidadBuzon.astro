<section id="comunidad" style="margin-bottom: 4.5rem; scroll-margin-top: 2rem;">
  
  <!-- Banner Principal de Crowdsourcing y Comunidad -->
  <div style="background: linear-gradient(135deg, #06182c 0%, #1e3a5f 100%); color: #ffffff; padding: 2.75rem 2.25rem; border-radius: 16px; box-shadow: var(--shadow-lg); margin-bottom: 2.5rem;">
    <div style="max-width: 820px;">
      <span style="background: var(--accent-green); color: #ffffff; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
        Buzón Abierto & Crowdsourcing
      </span>
      <h2 style="color: #ffffff; font-size: clamp(1.8rem, 3.5vw, 2.35rem); margin: 0.75rem 0 1rem 0;">
        Construyamos este Bien Público en Red
      </h2>
      <p style="color: #cbd5e1; font-size: 1.02rem; line-height: 1.6; margin-bottom: 1.75rem;">
        Brújula IA es un proyecto de ciencia ciudadana y bien público digital. Si tu universidad aprobó lineamientos recientes, emitió una resolución de rectoría o detectaste una omisión en el catastro, tu colaboración permite mantener los datos actualizados y libres para toda la comunidad académica.
      </p>

      <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        <button type="button" class="btn" style="background:#ffffff; color:#06182c; font-weight:700;" onclick="window.abrirModalAporte && window.abrirModalAporte()">
          📤 Aportar una Normativa o Decreto
        </button>
        <a href="mailto:eduardo@evegat.cl?subject=Sugerencia%20Br%C3%BAjula%20IA" class="btn" style="background:rgba(255,255,255,0.15); color:#ffffff; border:1px solid rgba(255,255,255,0.3);">
          ✉️ Escribir a Eduardo (eduardo@evegat.cl)
        </a>
      </div>
    </div>
  </div>

  <!-- Formulario de Suscripción a Alertas y Formulario de Contacto -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.75rem; margin-bottom:2.5rem;">
    
    <!-- Suscripción a Alertas Normativas (/api/subscribe) -->
    <div class="card">
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.5rem;">
        <span class="badge badge-blue">Boletín Abierto</span>
      </div>
      <h3 style="font-size:1.25rem; margin-bottom:0.5rem;">Alertas y Actualizaciones del Catastro</h3>
      <p style="font-size:0.88rem; color:var(--text-muted); margin-bottom:1.25rem; line-height:1.5;">
        Suscríbete para recibir notificaciones cuando se incorporen nuevos reglamentos, actualizaciones de la Ley N° 21.719 o nuevos reportes de compras públicas.
      </p>

      <form id="subscribe-form" style="display:flex; flex-direction:column; gap:0.85rem;">
        <input 
          type="email" 
          id="sub-email" 
          placeholder="tu.correo@universidad.cl" 
          required 
          style="padding:0.65rem 0.85rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.9rem;"
        />
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap:0.5rem;">
          <input 
            type="text" 
            id="sub-institucion" 
            placeholder="Tu universidad (opcional)" 
            style="padding:0.55rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.85rem;"
          />
          <select id="sub-perfil" style="padding:0.55rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.85rem;">
            <option value="investigador">Investigador(a)</option>
            <option value="docente">Docente</option>
            <option value="directivo">Directivo / Autoridad</option>
            <option value="estudiante">Estudiante</option>
            <option value="periodista">Periodista</option>
          </select>
        </div>
        <button type="submit" id="sub-submit-btn" class="btn btn-primary" style="margin-top:0.25rem;">
          🔔 Suscribirme a Alertas
        </button>
        <div id="sub-feedback" style="display:none; padding:0.6rem; border-radius:6px; font-size:0.82rem;"></div>
      </form>
    </div>

    <!-- Contacto Directo (/api/contact) -->
    <div class="card">
      <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.5rem;">
        <span class="badge badge-purple">Contacto Directo</span>
      </div>
      <h3 style="font-size:1.25rem; margin-bottom:0.5rem;">Mensaje para la Dirección del Observatorio</h3>
      <p style="font-size:0.88rem; color:var(--text-muted); margin-bottom:1.25rem; line-height:1.5;">
        ¿Tienes dudas sobre la metodología IMN, consultas sobre compras públicas o deseas coordinar un taller para tu plantel?
      </p>

      <form id="contact-form" style="display:flex; flex-direction:column; gap:0.85rem;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap:0.5rem;">
          <input 
            type="text" 
            id="cont-nombre" 
            placeholder="Tu nombre" 
            required 
            style="padding:0.6rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.85rem;"
          />
          <input 
            type="email" 
            id="cont-email" 
            placeholder="tu.correo@institucion.cl" 
            required 
            style="padding:0.6rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.85rem;"
          />
        </div>
        <textarea 
          id="cont-mensaje" 
          rows="3" 
          placeholder="Escribe tu mensaje o consulta..." 
          required 
          style="padding:0.65rem 0.75rem; border:1px solid var(--border-color); border-radius:6px; background:var(--card-bg); color:var(--text-main); font-size:0.85rem; resize:vertical;"
        ></textarea>
        <button type="submit" id="cont-submit-btn" class="btn btn-outline" style="margin-top:0.25rem;">
          ✉️ Enviar Mensaje
        </button>
        <div id="cont-feedback" style="display:none; padding:0.6rem; border-radius:6px; font-size:0.82rem;"></div>
      </form>
    </div>

  </div>

  <!-- Descarga de Datos Abiertos y Repositorio -->
  <div id="datos" class="card" style="padding:2rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem; margin-bottom:1.25rem;">
      <div>
        <span class="badge badge-green" style="margin-bottom:0.4rem;">Ciencia de Datos & Transparencia</span>
        <h3 style="font-size:1.35rem; margin-bottom:0.5rem;">Descarga de Datos Abiertos & API</h3>
        <p style="font-size:0.92rem; color:var(--text-muted); max-width:780px; line-height:1.5;">
          Todos los datasets compilados (catastro de normativas, matriz de las 54 universidades, compras públicas clasificadas y citas textuales) están a libre disposición de periodistas, investigadores y la comunidad académica bajo licencia Creative Commons Atribución 4.0 Internacional (CC BY 4.0).
        </p>
      </div>
    </div>

    <div style="display:flex; gap:0.85rem; flex-wrap:wrap;">
      <a href="/inventario.json" download="inventario_normativas_ia_chile.json" class="btn btn-primary btn-sm">
        💾 Catastro Completo (JSON)
      </a>
      <a href="/matriz_54_universidades.json" download="matriz_54_universidades_chile.json" class="btn btn-outline btn-sm">
        🏛️ Matriz 54 Universidades (JSON)
      </a>
      <a href="/compras_clasificadas.json" download="compras_publicas_ia_chile.json" class="btn btn-outline btn-sm">
        💰 Compras Públicas IA (JSON)
      </a>
      <a href="/citas_enriquecidas.json" download="citas_textuales_ia_chile.json" class="btn btn-outline btn-sm">
        📑 Citas & Cláusulas (JSON)
      </a>
      <a href="https://github.com/evegat/brujula-ia-edusuperior" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
        📦 GitHub (Corpus Markdown)
      </a>
    </div>
  </div>

</section>

<script is:inline>
  // Manejo de formulario de Suscripción
  const subForm = document.getElementById('subscribe-form');
  const subBtn = document.getElementById('sub-submit-btn');
  const subFeedback = document.getElementById('sub-feedback');

  subForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!subBtn || !subFeedback) return;

    subBtn.disabled = true;
    subBtn.textContent = 'Registrando...';
    subFeedback.style.display = 'none';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: document.getElementById('sub-email').value,
          institucion: document.getElementById('sub-institucion').value,
          perfil: document.getElementById('sub-perfil').value
        })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        subFeedback.style.display = 'block';
        subFeedback.style.background = 'var(--accent-green-soft)';
        subFeedback.style.color = 'var(--accent-green)';
        subFeedback.textContent = data.message;
        subForm.reset();
      } else {
        subFeedback.style.display = 'block';
        subFeedback.style.background = 'var(--accent-red-soft)';
        subFeedback.style.color = 'var(--accent-red)';
        subFeedback.textContent = data.error || 'Error al suscribirse.';
      }
    } catch (err) {
      subFeedback.style.display = 'block';
      subFeedback.style.background = 'var(--accent-red-soft)';
      subFeedback.style.color = 'var(--accent-red)';
      subFeedback.textContent = 'Error de conexión con el servidor.';
    } finally {
      subBtn.disabled = false;
      subBtn.textContent = '🔔 Suscribirme a Alertas';
    }
  });

  // Manejo de formulario de Contacto
  const contForm = document.getElementById('contact-form');
  const contBtn = document.getElementById('cont-submit-btn');
  const contFeedback = document.getElementById('cont-feedback');

  contForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!contBtn || !contFeedback) return;

    contBtn.disabled = true;
    contBtn.textContent = 'Enviando...';
    contFeedback.style.display = 'none';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: document.getElementById('cont-nombre').value,
          email: document.getElementById('cont-email').value,
          mensaje: document.getElementById('cont-mensaje').value
        })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        contFeedback.style.display = 'block';
        contFeedback.style.background = 'var(--accent-green-soft)';
        contFeedback.style.color = 'var(--accent-green)';
        contFeedback.textContent = data.message;
        contForm.reset();
      } else {
        contFeedback.style.display = 'block';
        contFeedback.style.background = 'var(--accent-red-soft)';
        contFeedback.style.color = 'var(--accent-red)';
        contFeedback.textContent = data.error || 'Error al enviar mensaje.';
      }
    } catch (err) {
      contFeedback.style.display = 'block';
      contFeedback.style.background = 'var(--accent-red-soft)';
      contFeedback.style.color = 'var(--accent-red)';
      contFeedback.textContent = 'Error de conexión con el servidor.';
    } finally {
      contBtn.disabled = false;
      contBtn.textContent = '✉️ Enviar Mensaje';
    }
  });
</script>
