---
import LanguageSelector from '../components/LanguageSelector.astro';
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  umamiId?: string;
  lang?: SupportedLang;
}

const { 
  lang = 'es',
  title,
  description,
  umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || "96982ca8-66da-4b58-976c-f98e06f05a6d"
} = Astro.props;

const t = useTranslations(lang);
const pageTitle = title || t('meta.title');
const pageDesc = description || t('meta.description');
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={`https://brujulaiaedusuperior.evegat.cl${Astro.url.pathname}`} />
  
  <!-- Favicon sobrio en SVG -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' fill='none' stroke='%230369a1' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='16' cy='16' r='14'/><polygon points='16 8 20 16 16 24 12 16' fill='%230369a1'/></svg>" />
  <meta name="theme-color" content="#082a46" />

  <!-- Open Graph / Redes / Buscadores -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://brujulaiaedusuperior.evegat.cl${Astro.url.pathname}`} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:site_name" content="Brújula IA Educación Superior" />
  <meta property="og:locale" content={lang === 'es' ? 'es_CL' : lang === 'pt' ? 'pt_BR' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />

  <!-- Schema.org JSON-LD (Dataset y WebSite) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://brujulaiaedusuperior.evegat.cl/#website",
        "url": "https://brujulaiaedusuperior.evegat.cl/",
        "name": "Brújula IA Educación Superior",
        "description": "Observatorio abierto, catastro de 54 universidades y comparador de políticas, directrices y compras de Inteligencia Artificial en la educación superior chilena.",
        "inLanguage": ["es-CL", "en", "pt"],
        "author": {
          "@type": "Person",
          "name": "Eduardo Vega Toledo",
          "url": "https://evegat.cl",
          "sameAs": [
            "https://www.linkedin.com/in/evegat1989/",
            "https://github.com/evegat"
          ]
        }
      },
      {
        "@type": "Dataset",
        "@id": "https://brujulaiaedusuperior.evegat.cl/#dataset",
        "name": "Matriz de Políticas y Directrices de IA en 54 Universidades de Chile",
        "description": "Catastro de 52 instrumentos de gobernanza de inteligencia artificial y 85 contratos de compras públicas en la educación superior chilena.",
        "url": "https://brujulaiaedusuperior.evegat.cl/",
        "creator": {
          "@type": "Person",
          "name": "Eduardo Vega Toledo"
        },
        "license": "https://creativecommons.org/licenses/by/4.0/",
        "distribution": [
          {
            "@type": "DataDownload",
            "encodingFormat": "text/csv",
            "contentUrl": "https://brujulaiaedusuperior.evegat.cl/matriz_54_universidades.csv"
          },
          {
            "@type": "DataDownload",
            "encodingFormat": "application/json",
            "contentUrl": "https://brujulaiaedusuperior.evegat.cl/matriz_54_universidades.json"
          }
        ]
      }
    ]
  })} />
  
  <!-- Tipografías Newsreader (Serif) e Inter (Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,600&display=swap" rel="stylesheet" />

  <!-- Telemetría Umami Oficial (analytics.evegat.cl) -->
  <script
    is:inline
    defer
    src="https://analytics.evegat.cl/script.js"
    data-website-id="96982ca8-66da-4b58-976c-f98e06f05a6d"
    data-host-url="https://analytics.evegat.cl"
    data-auto-track="true"
  ></script>

  <style is:global>
    :root {
      /* Tokens UDS v1.0 — Modo Claro */
      --header-bg: #ffffff;
      --canvas-bg: #f8fafc;
      --card-bg: #ffffff;
      --card-alt: #f1f5f9;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-subtle: #64748b;
      --border-color: #e2e8f0;
      --border-subtle: #f1f5f9;
      
      --accent-blue: #0369a1;
      --accent-blue-soft: rgba(3, 105, 161, 0.08);
      --accent-blue-hover: #0284c7;
      --accent-contrast: #ffffff;
      
      --accent-green: #059669;
      --accent-green-soft: rgba(5, 150, 105, 0.08);
      
      --accent-amber: #d97706;
      --accent-amber-soft: rgba(217, 119, 6, 0.08);
      
      --accent-red: #dc2626;
      --accent-red-soft: rgba(220, 38, 38, 0.08);
      
      --accent-purple: #6d28d9;
      --accent-purple-soft: rgba(109, 40, 217, 0.08);

      --font-serif: 'Newsreader', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: ui-monospace, 'JetBrains Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;

      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.06), 0 4px 6px -4px rgba(0, 0, 0, 0.03);
      --transition: all 0.15s ease-in-out;
    }

    [data-theme="dark"] {
      /* Tokens UDS v1.0 — Modo Oscuro Institucional */
      --header-bg: #070d18;
      --canvas-bg: #050a12;
      --card-bg: #0b1424;
      --card-alt: #0f1c32;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;
      --border-color: #1e293b;
      --border-subtle: #131e30;

      --accent-blue: #38bdf8;
      --accent-blue-soft: rgba(56, 189, 248, 0.12);
      --accent-blue-hover: #7dd3fc;
      --accent-contrast: #070d18;

      --accent-green: #34d399;
      --accent-green-soft: rgba(52, 211, 153, 0.12);

      --accent-amber: #fbbf24;
      --accent-amber-soft: rgba(251, 191, 36, 0.12);

      --accent-red: #f87171;
      --accent-red-soft: rgba(248, 113, 113, 0.12);

      --accent-purple: #c084fc;
      --accent-purple-soft: rgba(192, 132, 252, 0.12);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--canvas-bg);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .skip-link {
      position: absolute;
      top: -100px;
      left: 1rem;
      background: var(--accent-blue);
      color: var(--accent-contrast, #ffffff);
      padding: 0.6rem 1.2rem;
      z-index: 9999;
      border-radius: 6px;
      font-weight: 600;
      text-decoration: none;
      box-shadow: var(--shadow-md);
      transition: top 0.2s ease;
    }
    .skip-link:focus {
      top: 1rem;
      outline: 2px solid #ffffff;
    }

    [data-theme="dark"] .skip-link,
    [data-theme="dark"] .btn-accent,
    [data-theme="dark"] .tab-btn.active,
    [data-theme="dark"] .lang-btn.active {
      color: #050a12 !important;
      font-weight: 700 !important;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.25;
      letter-spacing: -0.015em;
    }

    h1 { font-size: clamp(2.1rem, 4vw, 3rem); }
    h2 { font-size: clamp(1.5rem, 2.8vw, 2.1rem); margin-bottom: 0.5rem; }
    h3 { font-size: clamp(1.2rem, 2.2vw, 1.45rem); margin-bottom: 0.4rem; }

    a {
      color: var(--accent-blue);
      text-decoration: none;
      transition: var(--transition);
    }
    a:hover {
      text-decoration: underline;
    }

    /* Utilidades UDS */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.74rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      line-height: 1.3;
      white-space: nowrap;
      border: 1px solid transparent;
    }
    .badge-blue { background: var(--accent-blue-soft); color: var(--accent-blue); border-color: rgba(3, 105, 161, 0.2); }
    .badge-green { background: var(--accent-green-soft); color: var(--accent-green); border-color: rgba(5, 150, 105, 0.2); }
    .badge-amber { background: var(--accent-amber-soft); color: var(--accent-amber); border-color: rgba(217, 119, 6, 0.2); }
    .badge-red { background: var(--accent-red-soft); color: var(--accent-red); border-color: rgba(220, 38, 38, 0.2); }
    .badge-purple { background: var(--accent-purple-soft); color: var(--accent-purple); border-color: rgba(109, 40, 217, 0.2); }
    .badge-subtle { background: var(--card-alt); color: var(--text-muted); border-color: var(--border-color); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.55rem 1.1rem;
      border-radius: 6px;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: var(--transition);
      text-decoration: none;
      white-space: nowrap;
      line-height: 1.4;
    }
    .btn:hover {
      text-decoration: none;
      transform: translateY(-1px);
    }
    .btn:active {
      transform: translateY(0);
    }
    .btn-primary {
      background: var(--text-main);
      color: var(--canvas-bg);
      border-color: var(--text-main);
    }
    .btn-primary:hover {
      opacity: 0.92;
      box-shadow: var(--shadow-sm);
    }
    .btn-outline {
      background: transparent;
      border-color: var(--border-color);
      color: var(--text-main);
    }
    .btn-outline:hover {
      background: var(--card-alt);
      border-color: var(--text-muted);
    }
    .btn-accent {
      background: var(--accent-blue);
      color: var(--accent-contrast, #ffffff);
      border-color: var(--accent-blue);
    }
    .btn-accent:hover {
      background: var(--accent-blue-hover);
      box-shadow: var(--shadow-sm);
    }
    .btn-sm {
      padding: 0.35rem 0.7rem;
      font-size: 0.78rem;
      border-radius: 4px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.35rem;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }
    .card:hover {
      border-color: rgba(3, 105, 161, 0.35);
      box-shadow: var(--shadow-md);
    }

    /* BARRA SUPERIOR DE ECOSISTEMA EVEGAT.CL (AUTORÍA Y RED) */
    .ecosystem-topbar {
      background: var(--card-alt);
      border-bottom: 1px solid var(--border-color);
      font-size: 0.74rem;
      padding: 0.4rem 1.5rem;
      color: var(--text-muted);
      position: relative;
      z-index: 999;
    }
    .ecosystem-topbar-inner {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .ecosystem-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .ecosystem-home-link {
      color: var(--text-main);
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .ecosystem-home-link:hover {
      color: var(--accent-blue);
      text-decoration: underline;
    }
    .ecosystem-home-link strong {
      font-weight: 700;
      color: var(--text-main);
    }
    .ecosystem-dot {
      opacity: 0.5;
    }
    .ecosystem-author {
      color: var(--text-muted);
      font-weight: 500;
    }
    .ecosystem-divider {
      color: var(--border-color);
      user-select: none;
    }
    .ecosystem-right {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .ecosystem-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.72rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: var(--transition);
    }
    .ecosystem-link:hover {
      color: var(--accent-blue);
      text-decoration: underline;
    }

    /* TOP NAVBAR INSTITUCIONAL */
    .top-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: var(--header-bg);
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }
    .top-header-inner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }
    .brand-group:hover {
      text-decoration: none;
    }
    .brand-logo-icon {
      width: 28px;
      height: 28px;
      color: var(--accent-blue);
      flex-shrink: 0;
    }
    .brand-title {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.1;
      letter-spacing: -0.01em;
    }
    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--text-subtle);
      font-weight: 500;
      line-height: 1.2;
    }

    .nav-links-desktop {
      display: flex;
      align-items: center;
    }
    .nav-links-list {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav-tab-link {
      background: none;
      border: none;
      color: var(--text-muted);
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 500;
      padding: 0.45rem 0.75rem;
      border-radius: 6px;
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
    }
    .nav-tab-link:hover {
      color: var(--text-main);
      background: var(--card-alt);
    }
    .nav-tab-link.active {
      color: var(--accent-blue);
      background: var(--accent-blue-soft);
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .theme-toggle-btn {
      background: var(--card-alt);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition);
      padding: 0;
    }
    .theme-toggle-btn:hover {
      color: var(--text-main);
      border-color: var(--text-muted);
    }
    .theme-icon {
      width: 16px;
      height: 16px;
      stroke: currentColor;
    }

    .mobile-menu-btn {
      display: none;
      background: var(--card-alt);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      width: 34px;
      height: 34px;
      border-radius: 6px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
    }

    .mobile-drawer {
      display: none;
      border-top: 1px solid var(--border-color);
      background: var(--header-bg);
      padding: 1rem 1.25rem;
    }
    .mobile-drawer.open {
      display: block;
    }
    .mobile-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .mobile-nav-link {
      width: 100%;
      text-align: left;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      font-size: 0.88rem;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-family: inherit;
    }
    .mobile-nav-link:hover, .mobile-nav-link.active {
      background: var(--card-alt);
      color: var(--text-main);
      font-weight: 600;
    }

    /* CONTENEDOR PRINCIPAL FLUIDO Y CENTRADO */
    .page-container {
      max-width: 1240px;
      width: 100%;
      margin: 0 auto;
      padding: 2.25rem 1.5rem 4rem 1.5rem;
      box-sizing: border-box;
      flex: 1;
    }

    @media (min-width: 1181px) {
      .mobile-drawer {
        display: none !important;
      }
    }

    @media (max-width: 1180px) {
      .nav-links-desktop {
        display: none;
      }
      .mobile-menu-btn {
        display: inline-flex;
      }
      .top-header-inner {
        padding: 0.65rem 1.25rem;
      }
      .page-container {
        padding: 1.5rem 1.15rem 3rem 1.15rem;
      }
    }

    @media (max-width: 768px) {
      .ecosystem-topbar {
        padding: 0.35rem 1.15rem;
      }
      .ecosystem-right {
        display: none;
      }
    }

    @media (max-width: 480px) {
      .ecosystem-topbar {
        padding: 0.35rem 0.75rem;
        font-size: 0.69rem;
      }
      .ecosystem-author {
        font-size: 0.68rem;
      }
      .top-header-inner {
        padding: 0.5rem 0.75rem;
        gap: 0.5rem;
      }
      .brand-group {
        gap: 0.45rem;
      }
      .brand-title {
        font-size: 1.05rem;
      }
      .brand-subtitle {
        display: none;
      }
      .header-actions {
        gap: 0.35rem;
      }
      .page-container {
        padding: 1.25rem 0.85rem 2.5rem 0.85rem;
      }
    }

    @media (max-width: 360px) {
      .ecosystem-topbar {
        padding: 0.3rem 0.45rem;
        font-size: 0.66rem;
      }
      .ecosystem-author {
        display: none;
      }
      .top-header-inner {
        padding: 0.4rem 0.45rem;
        gap: 0.3rem;
      }
      .brand-group {
        gap: 0.3rem;
      }
      .brand-logo-icon {
        width: 22px;
        height: 22px;
      }
      .brand-title {
        font-size: 0.92rem;
      }
      .theme-toggle-btn {
        width: 28px;
        height: 28px;
      }
      .mobile-menu-btn {
        width: 30px;
        height: 30px;
      }
      .page-container {
        padding: 1rem 0.5rem 2rem 0.5rem;
      }
    }
  </style>
</head>
<body>
  
  <a href="#main-content" class="skip-link">{t('skip_link')}</a>

  <!-- Barra Superior de Ecosistema evegat.cl (Autoría y Red) -->
  <div class="ecosystem-topbar" role="region" aria-label={t('eco.aria_label')}>
    <div class="ecosystem-topbar-inner">
      <div class="ecosystem-left">
        <a href="https://evegat.cl" target="_blank" rel="noopener noreferrer" class="ecosystem-home-link" title={t('eco.home_title')}>
          ← <strong>evegat.cl</strong> <span class="ecosystem-dot">·</span> <span>{t('eco.public_intel')}</span>
        </a>
        <span class="ecosystem-divider" aria-hidden="true">|</span>
        <span class="ecosystem-author">
          {t('eco.author')}
        </span>
      </div>
      <div class="ecosystem-right">
        <a href="https://observatoriotimunicipal.evegat.cl" target="_blank" rel="noopener noreferrer" class="ecosystem-link" title={t('eco.ti_title')}>
          🏛️ <span class="eco-link-text">Observatorio TI Municipal</span>
        </a>
        <span class="ecosystem-divider eco-hide-sm" aria-hidden="true">|</span>
        <a href="https://www.linkedin.com/in/evegat1989/" target="_blank" rel="noopener noreferrer" class="ecosystem-link" title={t('eco.linkedin_title')}>
          💼 <span class="eco-link-text">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Header Superior Institucional -->
  <header class="top-header mobile-header">
    <div class="top-header-inner">
      
      <!-- Brand & Isotipo SVG -->
      <a href="#inicio" class="brand-group">
        <svg class="brand-logo-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="16" cy="16" r="13" />
          <polygon points="16 7 19.5 16 16 25 12.5 16" fill="currentColor" fill-opacity="0.85" />
          <line x1="16" y1="3" x2="16" y2="5" />
          <line x1="16" y1="27" x2="16" y2="29" />
          <line x1="3" y1="16" x2="5" y2="16" />
          <line x1="27" y1="16" x2="29" y2="16" />
        </svg>
        <div>
          <div class="brand-title">{t('brand.name')}</div>
          <div class="brand-subtitle">{t('brand.subtitle')} · {t('brand.observatory')}</div>
        </div>
      </a>

      <!-- Navegación por Tabs en Desktop -->
      <nav aria-label={t('nav.aria_sections')} class="nav-links-desktop">
        <ul class="nav-links-list">
          <li><button type="button" class="nav-tab-link active" data-tab="tab-matriz">{t('nav.universities')}</button></li>
          <li><button type="button" class="nav-tab-link" data-tab="tab-kit">{t('nav.rules')}</button></li>
          <li><button type="button" class="nav-tab-link" data-tab="tab-compras">{t('nav.procurement')}</button></li>
          <li><button type="button" class="nav-tab-link" data-tab="tab-catalogo">{t('nav.catalog')}</button></li>
          <li><button type="button" class="nav-tab-link" data-tab="tab-metodologia">{t('nav.methodology')}</button></li>
        </ul>
      </nav>

      <!-- Acciones: Idioma, Modo Oscuro, Menú Móvil -->
      <div class="header-actions">
        <LanguageSelector currentLang={lang} />
        
        <!-- Toggle Modo Oscuro con SVG -->
        <button id="theme-btn" class="theme-toggle-btn" aria-label={t('theme.toggle_title')} title={t('theme.toggle')}>
          <!-- Luna (modo claro) -->
          <svg id="icon-moon" class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <!-- Sol (modo oscuro) -->
          <svg id="icon-sun" class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        </button>

        <!-- Botón Menú Móvil -->
        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label={t('nav.menu_open')} aria-expanded="false">
          <svg style="width:18px; height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Cajón Desplegable Móvil -->
    <div id="mobile-drawer" class="mobile-drawer">
      <ul class="mobile-nav-list">
        <li><button type="button" class="mobile-nav-link active" data-tab="tab-matriz">{t('nav.universities')}</button></li>
        <li><button type="button" class="mobile-nav-link" data-tab="tab-kit">{t('nav.rules')}</button></li>
        <li><button type="button" class="mobile-nav-link" data-tab="tab-compras">{t('nav.procurement')}</button></li>
        <li><button type="button" class="mobile-nav-link" data-tab="tab-catalogo">{t('nav.catalog')}</button></li>
        <li><button type="button" class="mobile-nav-link" data-tab="tab-metodologia">{t('nav.methodology')}</button></li>
      </ul>
    </div>
  </header>

  <!-- Contenedor Principal Centrado -->
  <main id="main-content" class="page-container">
    <slot />
  </main>

  <script is:inline>
    // Inicialización y persistencia de Tema (Light / Dark)
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      const moon = document.getElementById('icon-moon');
      const sun = document.getElementById('icon-sun');
      if (theme === 'dark') {
        if (moon) moon.style.display = 'none';
        if (sun) sun.style.display = 'block';
      } else {
        if (moon) moon.style.display = 'block';
        if (sun) sun.style.display = 'none';
      }
    }

    const savedTheme = localStorage.getItem('theme') || 
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    applyTheme(savedTheme);

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    }

    document.getElementById('theme-btn')?.addEventListener('click', toggleTheme);

    // Menú móvil
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');

    mobileBtn?.addEventListener('click', () => {
      const isOpen = drawer?.classList.contains('open');
      if (isOpen) {
        drawer?.classList.remove('open');
        mobileBtn.setAttribute('aria-expanded', 'false');
      } else {
        drawer?.classList.add('open');
        mobileBtn.setAttribute('aria-expanded', 'true');
      }
    });

    // Cerrar drawer al hacer clic en un link móvil
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        drawer?.classList.remove('open');
        mobileBtn?.setAttribute('aria-expanded', 'false');
      });
    });

    // Resetear drawer móvil si se amplía a pantalla de escritorio
    if (window.matchMedia) {
      window.matchMedia('(min-width: 1181px)').addEventListener('change', (e) => {
        if (e.matches && drawer) {
          drawer.classList.remove('open');
          mobileBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Telemetría de diagnóstico (errores no capturados y promesas)
    window.addEventListener('error', (event) => {
      if (typeof console !== 'undefined' && console.warn) {
        console.warn('[Brújula IA Telemetría] Excepción no capturada observada:', {
          type: 'uncaught_error',
          message: event.message,
          filename: event.filename,
          lineno: event.lineno,
          timestamp: new Date().toISOString()
        });
      }
    });

    window.addEventListener('unhandledrejection', (event) => {
      if (typeof console !== 'undefined' && console.warn) {
        console.warn('[Brújula IA Telemetría] Promesa rechazada sin capturar:', {
          type: 'unhandled_rejection',
          reason: event.reason ? (event.reason.message || String(event.reason)) : 'Desconocido',
          timestamp: new Date().toISOString()
        });
      }
    });

    // Helper global para navegar y filtrar compras de una universidad
    window.verComprasUniversidad = function(uniNombre) {
      if (!uniNombre) return;

      // 1. Activar pestaña de compras (en navbar principal o header tabs)
      const btnCompras = document.querySelector('.tab-btn[data-tab="tab-compras"]') || document.querySelector('.nav-tab-link[data-tab="tab-compras"]');
      if (btnCompras) {
        btnCompras.click();
      }

      // 2. Establecer filtro en el select de compras
      setTimeout(() => {
        const selectU = document.getElementById('compras-select-u');
        if (selectU) {
          const norm = (s) => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
          const target = norm(uniNombre);
          let found = '';
          for (const opt of selectU.options) {
            if (opt.value === 'todas') continue;
            const optNorm = norm(opt.value);
            if (target.includes(optNorm) || optNorm.includes(target)) {
              found = opt.value;
              break;
            }
          }
          if (found) {
            selectU.value = found;
            selectU.dispatchEvent(new Event('change'));
          }
        }

        // 3. Desplazar suavemente a la sección de compras
        const comprasSec = document.getElementById('compras') || document.getElementById('tab-compras');
        if (comprasSec) {
          const navOffset = comprasSec.getBoundingClientRect().top + window.pageYOffset;
          window.scrollTo({ top: Math.max(0, navOffset - 25), behavior: 'smooth' });
        }
      }, 80);
    };

    // Delegación global para botones de compras
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-ver-compras-action, .btn-ver-compras-badge');
      if (btn) {
        const uni = btn.getAttribute('data-uni-compras');
        if (uni && window.verComprasUniversidad) {
          window.verComprasUniversidad(uni);
        }
      }
    });
  </script>
</body>
</html>
