---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import GuiaUso from '../../components/GuiaUso.astro';
import MatrizNacional from '../../components/MatrizNacional.astro';
import PlanillaChequeo from '../../components/PlanillaChequeo.astro';
import KitAdopcionNacional from '../../components/KitAdopcionNacional.astro';
import CitasTextuales from '../../components/CitasTextuales.astro';
import CatalogoProtocolos from '../../components/CatalogoProtocolos.astro';
import ComprasPublicas from '../../components/ComprasPublicas.astro';
import MetodologiaYVersiones from '../../components/MetodologiaYVersiones.astro';
import Ecosistema from '../../components/Ecosistema.astro';
import ComunidadBuzon from '../../components/ComunidadBuzon.astro';
import BancoBuenasPracticas from '../../components/BancoBuenasPracticas.astro';
import SuscripcionComunidad from '../../components/SuscripcionComunidad.astro';
import BarraCompartir from '../../components/BarraCompartir.astro';
import Footer from '../../components/Footer.astro';
import ModalCrowdsourcing from '../../components/ModalCrowdsourcing.astro';
import ModalAvisoLegal from '../../components/ModalAvisoLegal.astro';
import ModalDescargaRegistro from '../../components/ModalDescargaRegistro.astro';
import ModalComparacionIntrauniversitaria from '../../components/ModalComparacionIntrauniversitaria.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('pt');
---

<Layout lang="pt">
  
  <!-- Encabezado Editorial e Visão Geral -->
  <Hero lang="pt" />

  <!-- Guia Rápido de Orientação -->
  <GuiaUso lang="pt" />

  <!-- Barra de Navegação Superior em Linguagem Clara -->
  <nav class="tabs-nav" aria-label="Seções do Observatório">
    <div class="tabs-container">
      <button class="tab-btn active" data-tab="tab-matriz">
        {t('nav.universities')}
      </button>
      <button class="tab-btn" data-tab="tab-kit">
        {t('nav.rules')}
      </button>
      <button class="tab-btn" data-tab="tab-compras">
        {t('nav.procurement')}
      </button>
      <button class="tab-btn" data-tab="tab-catalogo">
        {t('nav.catalog')}
      </button>
      <button class="tab-btn" data-tab="tab-metodologia">
        {t('nav.methodology')}
      </button>
    </div>
  </nav>

  <!-- Painéis de Conteúdo -->
  <div class="tabs-content">
    
    <!-- Seção 1: As 54 Universidades e Planilha de Checagem -->
    <div id="tab-matriz" class="tab-panel active">
      <MatrizNacional lang="pt" />
      <div style="margin-top: 4rem; padding-top: 2.5rem; border-top: 2px dashed var(--border-color);">
        <PlanillaChequeo lang="pt" />
      </div>
    </div>

    <!-- Seção 2: Modelos de Cláusulas e Privacidade -->
    <div id="tab-kit" class="tab-panel">
      <KitAdopcionNacional lang="pt" />
    </div>

    <!-- Seção 3: Compras Públicas em Tecnologia -->
    <div id="tab-compras" class="tab-panel">
      <ComprasPublicas lang="pt" />
    </div>

    <!-- Seção 4: Catálogo de Diretrizes e Citações -->
    <div id="tab-catalogo" class="tab-panel">
      <CatalogoProtocolos lang="pt" />
      <div style="margin-top: 3.5rem;">
        <CitasTextuales />
      </div>
    </div>

    <!-- Seção 5: Ideias Docentes, Metodologia e Dados Abertos -->
    <div id="tab-metodologia" class="tab-panel">
      <div id="ideas" style="scroll-margin-top: 2rem;">
        <BancoBuenasPracticas lang="pt" />
      </div>
      <div style="margin-top: 4rem; padding-top: 2.5rem; border-top: 2px dashed var(--border-color);">
        <MetodologiaYVersiones />
      </div>
      <div style="margin-top: 3.5rem;">
        <ComunidadBuzon />
      </div>
      <div style="margin-top: 3.5rem;">
        <Ecosistema />
      </div>
    </div>

  </div>

  <!-- Comunidade e Rodapé -->
  <SuscripcionComunidad lang="pt" />
  <BarraCompartir />

  <Footer lang="pt" />
  <ModalCrowdsourcing />
  <ModalAvisoLegal />
  <ModalDescargaRegistro />
  <ModalComparacionIntrauniversitaria lang="pt" />

</Layout>

<style>
  .tabs-nav {
    position: relative;
    background: var(--canvas-bg);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
    padding: 0.65rem 0;
    scroll-margin-top: 5rem;
  }

  .tabs-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tab-btn {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.95rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 6px;
    transition: var(--transition);
  }

  .tab-btn:hover {
    color: var(--text-main);
    border-color: var(--accent-blue);
  }

  .tab-btn.active {
    color: var(--accent-contrast, #ffffff);
    background: var(--accent-blue);
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeInTab 0.22s ease-out;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  (function initTabs() {
    function setupTabs() {
      const tabButtons = Array.from(document.querySelectorAll('.tab-btn'));
      const headerTabButtons = Array.from(document.querySelectorAll('.nav-tab-link, .mobile-nav-link'));
      const tabPanels = Array.from(document.querySelectorAll('.tab-panel'));
      const tabsNav = document.querySelector('.tabs-nav');

      function switchTab(tabId, shouldScroll = true) {
        // 1. Botones de tabs en la página
        tabButtons.forEach(btn => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // 2. Botones del header superior (desktop y mobile)
        headerTabButtons.forEach(btn => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // 3. Paneles de contenido
        tabPanels.forEach(panel => {
          if (panel.id === tabId) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });

        if (shouldScroll && tabsNav) {
          const navRect = tabsNav.getBoundingClientRect();
          const headerHeight = document.querySelector('.top-header')?.offsetHeight || 60;
          const targetY = window.pageYOffset + navRect.top;
          window.scrollTo({
            top: Math.max(0, targetY - headerHeight - 12),
            behavior: 'smooth'
          });
        }

        if (window.umami) {
          window.umami.track('tab_switch', { tab: tabId, lang: 'pt' });
        }
      }

      // Listeners para botones de tabs en la página
      tabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-tab');
          if (targetId) switchTab(targetId, true);
        });
      });

      // Listeners para botones del header superior
      headerTabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-tab');
          if (targetId) switchTab(targetId, true);
        });
      });

      function handleHashChange() {
        const hash = window.location.hash;
        if (hash === '#inicio') {
          switchTab('tab-matriz', false);
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        const hashMapping = {
          '#matriz-nacional': 'tab-matriz',
          '#planilla': 'tab-matriz',
          '#kit': 'tab-kit',
          '#ley-21719': 'tab-kit',
          '#ideas': 'tab-metodologia',
          '#buenas-practicas': 'tab-metodologia',
          '#compras': 'tab-compras',
          '#catalogo': 'tab-catalogo',
          '#clausulas': 'tab-catalogo',
          '#metodologia': 'tab-metodologia',
          '#datos': 'tab-metodologia',
          '#comunidad': 'tab-metodologia'
        };
        if (hashMapping[hash]) {
          switchTab(hashMapping[hash], true);
        }
      }

      window.addEventListener('hashchange', handleHashChange);
      if (window.location.hash) {
        handleHashChange();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTabs);
    } else {
      setupTabs();
    }
  })();
</script>
