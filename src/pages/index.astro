---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GuiaUso from '../components/GuiaUso.astro';
import MatrizNacional from '../components/MatrizNacional.astro';
import PlanillaChequeo from '../components/PlanillaChequeo.astro';
import ChecklistBenchmarking from '../components/ChecklistBenchmarking.astro';
import KitAdopcionNacional from '../components/KitAdopcionNacional.astro';
import CitasTextuales from '../components/CitasTextuales.astro';
import CatalogoProtocolos from '../components/CatalogoProtocolos.astro';
import ComprasPublicas from '../components/ComprasPublicas.astro';
import MetodologiaYVersiones from '../components/MetodologiaYVersiones.astro';
import Ecosistema from '../components/Ecosistema.astro';
import ComunidadBuzon from '../components/ComunidadBuzon.astro';
import BancoBuenasPracticas from '../components/BancoBuenasPracticas.astro';
import SuscripcionComunidad from '../components/SuscripcionComunidad.astro';
import BarraCompartir from '../components/BarraCompartir.astro';
import Footer from '../components/Footer.astro';
import ModalCrowdsourcing from '../components/ModalCrowdsourcing.astro';
import ModalAvisoLegal from '../components/ModalAvisoLegal.astro';
import ModalDescargaRegistro from '../components/ModalDescargaRegistro.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('es');
---

<Layout lang="es">
  
  <!-- Encabezado Editorial y Propósito -->
  <Hero lang="es" />

  <!-- Guía Rápida de Uso y Orientación -->
  <GuiaUso lang="es" />

  <!-- Barra de Navegación Sobria y en Lenguaje Claro -->
  <nav class="tabs-nav" aria-label="Secciones del Observatorio">
    <div class="tabs-container">
      <button class="tab-btn active" data-tab="tab-matriz">
        {t('nav.universities')}
      </button>
      <button class="tab-btn" data-tab="tab-kit">
        {t('nav.rules')}
      </button>
      <button class="tab-btn" data-tab="tab-ideas">
        {t('nav.ideas')}
      </button>
      <button class="tab-btn" data-tab="tab-compras">
        {t('nav.procurement')}
      </button>
      <button class="tab-btn" data-tab="tab-catalogo">
        {t('nav.catalog')}
      </button>
      <button class="tab-btn" data-tab="tab-metodologia">
        {t('nav.methodology')}
      </button>
    </div>
  </nav>

  <!-- Contenido por Secciones -->
  <div class="tabs-content">
    
    <!-- Sección 1: Universidades y Planilla de Chequeo -->
    <div id="tab-matriz" class="tab-panel active">
      <MatrizNacional lang="es" />
      <div style="margin-top: 4rem; padding-top: 2.5rem; border-top: 2px dashed var(--border-color);">
        <PlanillaChequeo lang="es" />
      </div>
    </div>

    <!-- Sección 2: Reglas Listas para Copiar y Radar Ley 21.719 -->
    <div id="tab-kit" class="tab-panel">
      <KitAdopcionNacional lang="es" />
    </div>

    <!-- Sección 3: Ideas y Casos Prácticos de Profesores -->
    <div id="tab-ideas" class="tab-panel">
      <BancoBuenasPracticas lang="es" />
    </div>

    <!-- Sección 4: Compras en Tecnología e IA -->
    <div id="tab-compras" class="tab-panel">
      <ComprasPublicas lang="es" />
    </div>

    <!-- Sección 5: Catálogo de Normativas y Citas Textuales -->
    <div id="tab-catalogo" class="tab-panel">
      <CatalogoProtocolos lang="es" />
      <div style="margin-top: 3.5rem;">
        <CitasTextuales />
      </div>
    </div>

    <!-- Sección 6: Metodología, Datos Abiertos y Comunidad -->
    <div id="tab-metodologia" class="tab-panel">
      <MetodologiaYVersiones />
      <div style="margin-top: 3.5rem;">
        <ComunidadBuzon />
      </div>
      <div style="margin-top: 3.5rem;">
        <Ecosistema />
      </div>
    </div>

  </div>

  <!-- Bloque de Comunidad, Alertas Consentidas y Difusión -->
  <SuscripcionComunidad lang="es" />
  <BarraCompartir />

  <Footer lang="es" />
  <ModalCrowdsourcing />
  <ModalAvisoLegal />
  <ModalDescargaRegistro />

</Layout>

<style>
  .tabs-nav {
    position: sticky;
    top: 0;
    background: var(--canvas-bg);
    z-index: 100;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
    padding: 0.65rem 0;
  }

  .tabs-container {
    display: flex;
    flex-wrap: wrap; /* Sin slider ni desborde horizontal */
    gap: 0.5rem;
    align-items: center;
  }

  .tab-btn {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.95rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 6px;
    transition: var(--transition);
  }

  .tab-btn:hover {
    color: var(--text-main);
    border-color: var(--accent-blue);
  }

  .tab-btn.active {
    color: #ffffff;
    background: var(--accent-blue);
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-sm);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeInTab 0.22s ease-out;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function setupTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const sidebarButtons = document.querySelectorAll<HTMLButtonElement>('.sidebar-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
    const sidebar = document.getElementById('main-sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function switchTab(tabId: string) {
      // Activar botones superiores
      tabButtons.forEach(btn => {
        if (btn.dataset.tab === tabId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Activar botones de la barra lateral
      sidebarButtons.forEach(btn => {
        if (btn.dataset.tab === tabId) {
          btn.classList.add('active');
          btn.style.color = '#34d399';
          btn.style.fontWeight = '600';
        } else {
          btn.classList.remove('active');
          btn.style.color = '#cbd5e1';
          btn.style.fontWeight = '400';
        }
      });

      // Mostrar panel activo
      tabPanels.forEach(panel => {
        if (panel.id === tabId) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });

      // Cerrar menú móvil si está abierto
      if (window.innerWidth <= 1024) {
        sidebar?.classList.remove('open');
        overlay?.classList.remove('active');
      }

      // Comportamiento parejo y consistente en ambas barras:
      // Si el usuario está desplazado más abajo que el inicio del contenido,
      // posicionar suavemente al inicio de las pestañas para no perder el encabezado.
      const tabsNav = document.querySelector('.tabs-nav') as HTMLElement;
      if (tabsNav) {
        const navOffsetTop = tabsNav.offsetTop;
        if (window.scrollY > navOffsetTop + 30) {
          window.scrollTo({
            top: Math.max(0, navOffsetTop - 15),
            behavior: 'smooth'
          });
        }
      }

      // Registrar evento en Umami
      if ((window as any).umami) {
        (window as any).umami.track('tab_switch', { tab: tabId });
      }
    }

    // Clics en botones superiores
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.tab;
        if (targetId) switchTab(targetId);
      });
    });

    // Clics en botones de la barra lateral
    sidebarButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.tab;
        if (targetId) switchTab(targetId);
      });
    });

    // Mapeo de hashes externos o enlaces
    function handleHashChange() {
      const hash = window.location.hash;
      const hashMapping: Record<string, string> = {
        '#matriz-nacional': 'tab-matriz',
        '#planilla': 'tab-matriz',
        '#inicio': 'tab-matriz',
        '#kit': 'tab-kit',
        '#ley-21719': 'tab-kit',
        '#ideas': 'tab-ideas',
        '#buenas-practicas': 'tab-ideas',
        '#compras': 'tab-compras',
        '#catalogo': 'tab-catalogo',
        '#clausulas': 'tab-catalogo',
        '#metodologia': 'tab-metodologia',
        '#datos': 'tab-metodologia',
        '#comunidad': 'tab-metodologia'
      };
      if (hashMapping[hash]) {
        switchTab(hashMapping[hash]);
      }
    }

    window.addEventListener('hashchange', handleHashChange);
    if (window.location.hash) {
      handleHashChange();
    }
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTabs);
  } else {
    setupTabs();
  }
</script>
