---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import GuiaUso from '../../components/GuiaUso.astro';
import MatrizNacional from '../../components/MatrizNacional.astro';
import PlanillaChequeo from '../../components/PlanillaChequeo.astro';
import KitAdopcionNacional from '../../components/KitAdopcionNacional.astro';
import CitasTextuales from '../../components/CitasTextuales.astro';
import CatalogoProtocolos from '../../components/CatalogoProtocolos.astro';
import ComprasPublicas from '../../components/ComprasPublicas.astro';
import MetodologiaYVersiones from '../../components/MetodologiaYVersiones.astro';
import Ecosistema from '../../components/Ecosistema.astro';
import ComunidadBuzon from '../../components/ComunidadBuzon.astro';
import BancoBuenasPracticas from '../../components/BancoBuenasPracticas.astro';
import SuscripcionComunidad from '../../components/SuscripcionComunidad.astro';
import BarraCompartir from '../../components/BarraCompartir.astro';
import Footer from '../../components/Footer.astro';
import ModalCrowdsourcing from '../../components/ModalCrowdsourcing.astro';
import ModalAvisoLegal from '../../components/ModalAvisoLegal.astro';
import ModalDescargaRegistro from '../../components/ModalDescargaRegistro.astro';
import ModalComparacionIntrauniversitaria from '../../components/ModalComparacionIntrauniversitaria.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');
---

<Layout lang="en">
  
  <!-- Editorial Header & Overview -->
  <Hero lang="en" />

  <!-- Quick User Orientation -->
  <GuiaUso lang="en" />

  <!-- Top Navigation in Plain Language -->
  <nav class="tabs-nav" aria-label="Observatory Sections">
    <div class="tabs-container">
      <button class="tab-btn active" data-tab="tab-matriz">
        {t('nav.universities')}
      </button>
      <button class="tab-btn" data-tab="tab-kit">
        {t('nav.rules')}
      </button>
      <button class="tab-btn" data-tab="tab-ideas">
        {t('nav.ideas')}
      </button>
      <button class="tab-btn" data-tab="tab-compras">
        {t('nav.procurement')}
      </button>
      <button class="tab-btn" data-tab="tab-catalogo">
        {t('nav.catalog')}
      </button>
      <button class="tab-btn" data-tab="tab-metodologia">
        {t('nav.methodology')}
      </button>
    </div>
  </nav>

  <!-- Tab Panels -->
  <div class="tabs-content">
    
    <!-- Section 1: 54 Universities & Checklist -->
    <div id="tab-matriz" class="tab-panel active">
      <MatrizNacional lang="en" />
      <div style="margin-top: 4rem; padding-top: 2.5rem; border-top: 2px dashed var(--border-color);">
        <PlanillaChequeo lang="en" />
      </div>
    </div>

    <!-- Section 2: Ready-to-use Rules & Privacy -->
    <div id="tab-kit" class="tab-panel">
      <KitAdopcionNacional lang="en" />
    </div>

    <!-- Section 3: Faculty Ideas & Best Practices -->
    <div id="tab-ideas" class="tab-panel">
      <BancoBuenasPracticas lang="en" />
    </div>

    <!-- Section 4: Public Procurement -->
    <div id="tab-compras" class="tab-panel">
      <ComprasPublicas lang="en" />
    </div>

    <!-- Section 5: Policy Catalog & Direct Citations -->
    <div id="tab-catalogo" class="tab-panel">
      <CatalogoProtocolos lang="en" />
      <div style="margin-top: 3.5rem;">
        <CitasTextuales />
      </div>
    </div>

    <!-- Section 6: Methodology & Open Data -->
    <div id="tab-metodologia" class="tab-panel">
      <MetodologiaYVersiones />
      <div style="margin-top: 3.5rem;">
        <ComunidadBuzon />
      </div>
      <div style="margin-top: 3.5rem;">
        <Ecosistema />
      </div>
    </div>

  </div>

  <!-- Community & Footer -->
  <SuscripcionComunidad lang="en" />
  <BarraCompartir />

  <Footer lang="en" />
  <ModalCrowdsourcing />
  <ModalAvisoLegal />
  <ModalDescargaRegistro />
  <ModalComparacionIntrauniversitaria lang="en" />

</Layout>

<style>
  .tabs-nav {
    position: sticky;
    top: 0;
    background: var(--canvas-bg);
    z-index: 100;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
    padding: 0.65rem 0;
  }

  .tabs-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tab-btn {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.95rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 6px;
    transition: var(--transition);
  }

  .tab-btn:hover {
    color: var(--text-main);
    border-color: var(--accent-blue);
  }

  .tab-btn.active {
    color: #ffffff;
    background: var(--accent-blue);
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-sm);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeInTab 0.22s ease-out;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  (function initTabs() {
    function setupTabs() {
      const tabButtons = Array.from(document.querySelectorAll('.tab-btn'));
      const sidebarButtons = Array.from(document.querySelectorAll('.sidebar-tab-btn'));
      const tabPanels = Array.from(document.querySelectorAll('.tab-panel'));
      const sidebar = document.getElementById('main-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const tabsNav = document.querySelector('.tabs-nav');

      function switchTab(tabId, shouldScroll = true) {
        tabButtons.forEach(btn => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        sidebarButtons.forEach(btn => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        tabPanels.forEach(panel => {
          if (panel.id === tabId) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });

        if (window.innerWidth <= 1024) {
          if (sidebar) sidebar.classList.remove('open');
          if (overlay) overlay.classList.remove('active');
        }

        if (shouldScroll && tabsNav) {
          const navRect = tabsNav.getBoundingClientRect();
          const targetY = window.pageYOffset + navRect.top;
          window.scrollTo({
            top: Math.max(0, targetY - 15),
            behavior: 'smooth'
          });
        }

        if (window.umami) {
          window.umami.track('tab_switch', { tab: tabId, lang: 'en' });
        }
      }

      tabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-tab');
          if (targetId) switchTab(targetId, true);
        });
      });

      sidebarButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-tab');
          if (targetId) switchTab(targetId, true);
        });
      });

      function handleHashChange() {
        const hash = window.location.hash;
        if (hash === '#inicio') {
          switchTab('tab-matriz', false);
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        const hashMapping = {
          '#matriz-nacional': 'tab-matriz',
          '#planilla': 'tab-matriz',
          '#kit': 'tab-kit',
          '#ley-21719': 'tab-kit',
          '#ideas': 'tab-ideas',
          '#buenas-practicas': 'tab-ideas',
          '#compras': 'tab-compras',
          '#catalogo': 'tab-catalogo',
          '#clausulas': 'tab-catalogo',
          '#metodologia': 'tab-metodologia',
          '#datos': 'tab-metodologia',
          '#comunidad': 'tab-metodologia'
        };
        if (hashMapping[hash]) {
          switchTab(hashMapping[hash], true);
        }
      }

      window.addEventListener('hashchange', handleHashChange);
      if (window.location.hash) {
        handleHashChange();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTabs);
    } else {
      setupTabs();
    }
  })();
</script>
