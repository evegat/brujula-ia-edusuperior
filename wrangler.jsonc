{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "normatia",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "normatia.evegat.cl/*",
      "zone_name": "evegat.cl"
    }
  ]
}
